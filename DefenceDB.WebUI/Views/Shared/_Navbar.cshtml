@inject DefenceDB.BLL.Abstract.ICategoryQueryService CategoryService
@{
    var rootCategories = await CategoryService.GetCategoriesWithChildrenAsync();
    var activeSlug = ViewContext.RouteData.Values["categorySlug"]?.ToString() ?? Context.Request.Query["categorySlug"].ToString();

    bool IsCategoryActive(DefenceDB.EL.Models.Category cat) {
        if (cat == null) return false;
        if (string.Equals(cat.Slug, activeSlug, StringComparison.OrdinalIgnoreCase)) return true;
        if (cat.SubCategories != null) {
            foreach(var sc in cat.SubCategories) {
                if (IsCategoryActive(sc)) return true;
            }
        }
        return false;
    }
}

<link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

<div class="header-wrapper @(ViewData["IsHome"] as bool? == true ? "navbar-transparent-home" : "")">
    <!-- Top Row: Logo, Search, Links -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-top-row py-2" style="background-color: var(--bg-navbar); border-bottom: 1px solid rgba(255,255,255,0.05); position: relative; z-index: 1050;">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <a class="navbar-brand d-flex align-items-center gap-2 me-3" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-fill text-warning fs-3"></i>
                <span class="brand-text d-none d-sm-block">DEFENCE<strong class="text-warning">DB</strong></span>
            </a>

            <div class="me-auto"></div>

            <div class="d-flex align-items-center gap-3 ms-auto">
                <div id="searchContainer" class="position-relative">
                    <!-- Mobile search trigger button -->
                    <button type="button" id="mobileSearchTrigger" class="btn btn-link p-0 border-0 d-md-none" style="font-size: 1.25rem; line-height: 1; color: #ffc107 !important;">
                        <i class="bi bi-search"></i>
                    </button>

                    <form asp-controller="Product" asp-action="Index" method="get" class="position-relative d-flex align-items-center" id="searchForm">
                        <i class="bi bi-search position-absolute text-secondary-theme d-none d-md-block" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 0.9rem; z-index: 5;"></i>
                        <input type="text" id="searchInput" name="search" class="form-control rounded-pill bg-theme text-primary-theme border-theme"
                               placeholder="Platform ara..." autocomplete="off" style="width: 240px; transition: width 0.3s ease;" />
                        
                        <button type="button" id="mobileSearchClose" class="btn btn-link text-secondary-theme p-0 border-0 d-none" style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); z-index: 5; font-size: 1.2rem; line-height: 1;">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </form>
                    <div id="searchSuggestions" class="position-absolute w-100 bg-theme-card border border-theme rounded-3 shadow-lg d-none mt-2" style="z-index: 1060; max-height: 400px; overflow-y: auto; right: 0;">
                        <div class="list-group list-group-flush" id="searchSuggestionsList">
                        </div>
                    </div>
                </div>

                <a asp-controller="Articles" asp-action="Index" class="nav-link text-warning d-flex align-items-center gap-1" style="font-size: 0.95rem; font-weight: 600;">
                    <i class="bi bi-journal-text" style="font-size: 1.25rem;"></i>
                    <span class="d-none d-md-inline">Makaleler</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Bottom Row: Categories Bar -->
    <nav class="categories-nav-wrapper position-relative" style="background-color: #0b0f19; z-index: 1040;">
        <div class="container-fluid px-4">
            <ul class="categories-level1 d-flex align-items-center justify-content-center list-unstyled mb-0 m-0 p-0 flex-wrap">
                @foreach (var rootCat in rootCategories.OrderBy(c => c.Name))
                {
                    var isRootActive = IsCategoryActive(rootCat);
                    <li class="cat-item-level1 @(isRootActive ? "mobile-active" : "")" data-cat-id="@rootCat.Id">
                        <a href="@Url.Action("Index", "Product", new { categorySlug = rootCat.Slug })" class="cat-link-level1 d-block py-2 px-3 text-decoration-none fw-semibold @(isRootActive ? "mobile-active-text" : "")">
                            @rootCat.Name
                        </a>

                        @if (rootCat.SubCategories != null && rootCat.SubCategories.Any())
                        {
                            <div class="categories-level2-bar position-absolute start-0 end-0 w-100 shadow-lg" style="background-color: #151b2b; top: 100%; display: none; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <ul class="d-flex align-items-center justify-content-center list-unstyled mb-0 m-0 p-2 flex-wrap gap-4">
                                    @foreach (var child in rootCat.SubCategories.OrderBy(c => c.Name))
                                    {
                                        var isChildActive = IsCategoryActive(child);
                                        <li class="cat-item-level2 position-static @(isChildActive ? "mobile-active" : "")">
                                            <a href="@Url.Action("Index", "Product", new { categorySlug = child.Slug })" class="cat-link-level2 text-decoration-none d-block py-1 @(isChildActive ? "mobile-active-text fw-bold" : "")">
                                                @child.Name
                                            </a>

                                            @if (child.SubCategories != null && child.SubCategories.Any())
                                            {
                                                <div class="categories-level3-bar position-absolute start-0 end-0 w-100 shadow-lg" style="background-color: #1e293b; top: 100%; display: none; z-index: 1045; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                    <ul class="d-flex align-items-center justify-content-center list-unstyled mb-0 m-0 p-2 flex-wrap gap-4">
                                                        @foreach (var subSub in child.SubCategories.OrderBy(c => c.Name))
                                                        {
                                                            var isSubSubActive = IsCategoryActive(subSub);
                                                            <li>
                                                                <a href="@Url.Action("Index", "Product", new { categorySlug = subSub.Slug })" class="cat-link-level3 text-decoration-none d-block py-1 @(isSubSubActive ? "mobile-active-text fw-bold" : "")">
                                                                    @subSub.Name
                                                                </a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </nav>
</div>

<script src="~/js/navbar.js" asp-append-version="true"></script>
