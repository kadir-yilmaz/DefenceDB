@inject DefenceDB.BLL.Abstract.ICategoryQueryService CategoryService
@{
    var rootCategories = await CategoryService.GetCategoriesWithChildrenAsync();
    var productCounts = await CategoryService.GetCategoryProductCountsAsync();
}

<link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

<div class="udemy-navbar-container @(ViewData["IsHome"] as bool? == true ? "navbar-transparent-home" : "")">

    <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-slate-850 py-2" style="background-color: var(--bg-navbar); transition: background-color 0.3s ease; position: relative;">
        <div class="container-fluid px-4 align-items-center">

            <a class="navbar-brand d-flex align-items-center gap-2 me-3" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-fill text-warning fs-3"></i>
                <span class="brand-text d-none d-sm-block">DEFENCE<strong class="text-warning">DB</strong></span>
            </a>

            <div class="me-auto" style="position: static;">
                <button class="categories-trigger-btn" id="categoriesTriggerBtn" aria-label="Tüm Kategoriler">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    <span class="d-none d-md-inline">Kategoriler</span>
                </button>

                <div class="mega-menu" id="megaMenu">
                    <div class="mega-menu-inner">
                        <div class="mega-menu-sidebar" id="megaMenuSidebar">
                            @foreach (var rootCat in rootCategories.OrderBy(c => c.Name))
                            {
                                <a href="@Url.Action("Index", "Product", new { categorySlug = rootCat.Slug })" class="mega-menu-sidebar-item" data-category-id="@rootCat.Id">
                                    @if (!string.IsNullOrEmpty(rootCat.IconClass))
                                    {
                                        <i class="@rootCat.IconClass"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-folder2"></i>
                                    }
                                    <span>@rootCat.Name</span>
                                    <i class="bi bi-chevron-right ms-auto"></i>
                                </a>
                            }
                        </div>
                        <div class="mega-menu-content" id="megaMenuContent">
                            @foreach (var rootCat in rootCategories.OrderBy(c => c.Name))
                            {
                                if (rootCat.SubCategories != null && rootCat.SubCategories.Any())
                                {
                                    <div class="mega-menu-content-panel" data-category-id="@rootCat.Id">
                                        <div class="mega-menu-grid">
                                            @foreach (var child in rootCat.SubCategories)
                                            {
                                                <a href="@Url.Action("Index", "Product", new { categorySlug = child.Slug })" class="mega-menu-grid-item">
                                                    @if (!string.IsNullOrEmpty(child.IconClass))
                                                    {
                                                        <i class="@child.IconClass"></i>
                                                    }
                                                    <span>@child.Name</span>
                                                    <span class="mega-menu-count">(@productCounts.GetValueOrDefault(child.Id, 0))</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="mega-menu-content-panel" data-category-id="@rootCat.Id">
                                        <div class="mega-menu-empty">
                                            <i class="bi bi-inbox fs-1 opacity-50"></i>
                                            <p>Alt kategori yok</p>
                                            <a href="@Url.Action("Index", "Product", new { categorySlug = rootCat.Slug })" class="btn btn-sm btn-outline-warning mt-2">Tüm ürünleri gör</a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <button class="navbar-toggler border-0 shadow-none ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTopContent" aria-controls="navbarTopContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarTopContent">
                <div class="flex-grow-1"></div>
                <div class="me-3 my-2 my-lg-0 position-relative" id="searchContainer">
                    <form asp-controller="Product" asp-action="Index" method="get" class="position-relative">
                        <i class="bi bi-search position-absolute text-secondary-theme" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 0.9rem; z-index: 5;"></i>
                        <input type="text" id="searchInput" name="search" class="form-control rounded-pill bg-theme text-primary-theme border-theme"
                               style="padding-left: 38px; width: 240px; font-size: 0.85rem; transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);"
                               placeholder="Platform ara..." autocomplete="off"
                               onfocus="this.style.width='450px'" onblur="setTimeout(() => { if(!$('#searchSuggestions').is(':hover')) this.style.width='240px'; }, 200)" />
                    </form>

                    <div id="searchSuggestions" class="position-absolute w-100 bg-theme-card border border-theme rounded-3 shadow-lg d-none mt-2" style="z-index: 1050; max-height: 400px; overflow-y: auto;">
                        <div class="list-group list-group-flush" id="searchSuggestionsList">
                        </div>
                    </div>
                </div>

                <a asp-controller="Benchmark" asp-action="Index" class="nav-link text-warning d-flex align-items-center gap-1 ms-2" style="font-size: 0.85rem; font-weight: 600; white-space: nowrap;">
                    <i class="bi bi-speedometer2"></i>
                    <span class="d-none d-lg-inline">Benchmark</span>
                </a>
            </div>
        </div>
    </nav>
</div>

<script src="~/js/navbar.js" asp-append-version="true"></script>
    