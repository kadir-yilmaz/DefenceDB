@using DefenceDB.EL.Helpers
@model Article
@{
    ViewData["Title"] = Model.Title;
    var publishedAt = Model.PublishedAt ?? Model.CreatedAt;
    var isEditorJs = EditorJsRenderer.IsEditorJsFormat(Model.ContentMarkdown);
}

<link rel="stylesheet" href="~/css/articles.css" asp-append-version="true" />
@if (isEditorJs)
{
    <link rel="stylesheet" href="~/css/editorjs-article.css" asp-append-version="true" />
}

<article class="article-detail-page">
    <div class="container py-5">
        <a asp-controller="Articles" asp-action="Index" class="article-back-link">
            <i class="bi bi-arrow-left"></i> Makaleler
        </a>

        <div class="article-paper">
            <header class="article-detail-header">
                <div class="article-card-meta">
                    <span>@Model.ArticleCategory?.Name</span>
                    <time datetime="@publishedAt.ToString("yyyy-MM-dd")">@publishedAt.ToString("dd.MM.yyyy")</time>
                </div>
                <h1>@Model.Title</h1>
            </header>

            <div class="article-markdown markdown-content">
                @if (isEditorJs)
                {
                    @Html.Raw(EditorJsRenderer.RenderToHtml(Model.ContentMarkdown))
                }
                else
                {
                    @Html.Raw(Model.ContentMarkdown.ToHtmlFormat())
                }
            </div>
        </div>
    </div>
</article>
