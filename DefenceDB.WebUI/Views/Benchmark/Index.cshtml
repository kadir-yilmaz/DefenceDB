@{
    ViewData["Title"] = "Performans Benchmark";
}

<style>
    /* Override the global * transition from site.css that causes flicker */
    .benchmark-hero,
    .benchmark-hero *,
    .benchmark-hero *::before,
    .benchmark-hero *::after {
        transition: none !important;
    }
    /* Re-enable only specific transitions we actually want */
    .benchmark-hero .glass-card {
        transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease !important;
    }
    .benchmark-hero .bench-btn {
        transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease !important;
    }
    .benchmark-hero .bench-search-input {
        transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
    }
    .benchmark-hero .stat-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease !important;
    }
    .benchmark-hero .history-row {
        transition: background 0.2s ease !important;
    }

    /* Force dark background on entire page to prevent white flash */
    body:has(.benchmark-hero),
    body:has(.benchmark-hero) .app-container,
    body:has(.benchmark-hero) main {
        background-color: #0f172a !important;
    }

    .benchmark-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
        min-height: 100vh;
        padding: 2rem 0 4rem;
        position: relative;
        overflow: hidden;
    }

    .benchmark-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 30% 50%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
                    radial-gradient(ellipse at 70% 20%, rgba(168, 85, 247, 0.06) 0%, transparent 50%),
                    radial-gradient(ellipse at 50% 80%, rgba(245, 158, 11, 0.04) 0%, transparent 50%);
        pointer-events: none;
        will-change: opacity;
        animation: auroraFade 8s ease-in-out infinite alternate;
    }

    @@keyframes auroraFade {
        0% { opacity: 0.6; }
        100% { opacity: 1; }
    }

    .bench-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        background: linear-gradient(135deg, #60a5fa, #a78bfa, #f59e0b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
    }

    .bench-subtitle {
        color: #94a3b8;
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        letter-spacing: 0.5px;
    }

    /* Status badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 9999px;
        font-size: 0.8rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        backdrop-filter: blur(10px);
    }

    .status-active {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .status-inactive {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-active .status-dot {
        background: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
        animation: pulse-green 2s infinite;
    }

    .status-inactive .status-dot {
        background: #f87171;
    }

    @@keyframes pulse-green {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* Glass card */
    .glass-card {
        background: rgba(30, 41, 59, 0.5);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(148, 163, 184, 0.1);
        border-radius: 16px;
        padding: 1.75rem;
        position: relative;
        overflow: hidden;
    }

    .glass-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.2), transparent);
    }

    .glass-card:hover {
        border-color: rgba(148, 163, 184, 0.2);
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .card-title-sm {
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        color: #e2e8f0;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .card-desc {
        color: #94a3b8;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        margin-bottom: 1rem;
    }

    /* Scenario buttons */
    .bench-btn {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 10px 24px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        position: relative;
        overflow: hidden;
    }

    .bench-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%);
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .bench-btn:hover::after {
        opacity: 1;
    }

    .bench-btn-primary {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
    }

    .bench-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    .bench-btn-danger {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    .bench-btn-danger:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
    }

    .bench-btn-success {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff;
        box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
    }

    .bench-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
    }

    /* Chart container */
    .chart-container {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(148, 163, 184, 0.08);
        border-radius: 16px;
        padding: 1.5rem;
        margin-top: 2rem;
    }

    .chart-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        color: #e2e8f0;
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    /* Loading spinner */
    .bench-spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Search input */
    .bench-search-input {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 10px;
        color: #e2e8f0;
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        padding: 10px 16px;
        width: 100%;
        transition: border-color 0.2s ease;
    }

    .bench-search-input:focus {
        outline: none;
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .bench-search-input::placeholder {
        color: #64748b;
    }

    /* ═══════════════ STAT CARDS ═══════════════ */
    .stat-card {
        background: rgba(30, 41, 59, 0.4);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(148, 163, 184, 0.08);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: var(--stat-accent, linear-gradient(90deg, #3b82f6, #60a5fa));
    }
    .stat-card:hover {
        border-color: rgba(148, 163, 184, 0.15);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }
    .stat-icon {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        display: block;
    }
    .stat-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.75rem;
        font-weight: 800;
        color: #f1f5f9;
        line-height: 1;
        margin-bottom: 0.25rem;
    }
    .stat-label {
        font-family: 'Inter', sans-serif;
        font-size: 0.78rem;
        color: #94a3b8;
        font-weight: 500;
    }

    /* ═══════════════ ARCHITECTURE DIAGRAM (SVG) ═══════════════ */
    .arch-diagram {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(148, 163, 184, 0.08);
        border-radius: 16px;
        padding: 2rem;
        margin-top: 2rem;
        position: relative;
        overflow: hidden;
    }
    .arch-diagram svg {
        display: block;
        width: 100%;
        height: auto;
    }

    /* Query Code Block */
    .query-code-block {
        background: #020617;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 8px;
        padding: 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #cbd5e1;
        max-height: 120px;
        overflow-y: auto;
        white-space: pre-wrap;
        text-align: left;
    }

    /* JSON Syntax Highlighting */
    .json-key { color: #fda4af; font-weight: 600; }     /* Bright light rose keys */
    .json-string { color: #6ee7b7; }                  /* Bright light emerald strings */
    .json-number { color: #7dd3fc; }                  /* Bright light sky numbers */
    .json-boolean { color: #fde047; font-weight: bold; } /* Bright light amber booleans */
    .json-null { color: #cbd5e1; font-style: italic; }   /* Light gray nulls */

    /* Modal pre content text styling */
    #detailModalContent {
        font-family: 'JetBrains Mono', 'Fira Code', monospace !important;
        font-size: 0.74rem !important; /* Make font slightly smaller as requested */
        color: #f8fafc !important; /* Make text much brighter */
        line-height: 1.6 !important;
    }

    #detailModalContent::-webkit-scrollbar {
        width: 8px;
    }
    #detailModalContent::-webkit-scrollbar-track {
        background: #020617;
    }
    #detailModalContent::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
    }
    #detailModalContent::-webkit-scrollbar-thumb:hover {
        background: #334155;
    }

    /* Split-Screen Thumbnail Selection */
    .view-thumbnail-card {
        border: 1px solid rgba(148, 163, 184, 0.12) !important;
        background: rgba(15, 23, 42, 0.3) !important;
        border-radius: 10px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .view-thumbnail-card:hover {
        border-color: rgba(96, 165, 250, 0.4) !important;
        background: rgba(30, 41, 59, 0.4) !important;
        transform: translateY(-1px);
    }
    .view-thumbnail-card.active {
        border-color: #3b82f6 !important;
        background: rgba(59, 130, 246, 0.08) !important;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.15);
    }
    .thumb-icon-container {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(148, 163, 184, 0.08);
        color: #94a3b8;
        transition: all 0.25s ease;
    }
    .view-thumbnail-card.active .thumb-icon-container {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
    }
    .hover-white:hover {
        color: #ffffff !important;
    }

    /* ═══════════════ LIVE DEVELOPER CONSOLE ═══════════════ */
    .console-container {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(148, 163, 184, 0.08);
        border-radius: 16px;
        padding: 1.5rem;
        margin-top: 2rem;
    }
    .console-box {
        background: #020617;
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 10px;
        padding: 1rem;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.8rem;
        height: 180px;
        overflow-y: auto;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.8);
    }
    .console-line {
        margin-bottom: 4px;
        line-height: 1.4;
        white-space: pre-wrap;
    }
    .console-line.info { color: #38bdf8; }
    .console-line.cmd { color: #a78bfa; font-weight: 600; }
    .console-line.sql { color: #60a5fa; }
    .console-line.flat { color: #34d399; }
    .console-line.es { color: #c084fc; }
    .console-line.cache { color: #fbbf24; }
    .console-line.success { color: #4ade80; }
    .console-line.warning { color: #f87171; }

    /* ═══════════════ TEST HISTORY TABLE ═══════════════ */
    .history-container {
        margin-top: 2rem;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(148, 163, 184, 0.08);
        border-radius: 16px;
        padding: 1.5rem;
    }
    .history-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }
    .history-table th, .history-table td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid rgba(148, 163, 184, 0.08);
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
    }
    .history-table th {
        background: rgba(30, 41, 59, 0.4);
        color: #fff !important;
        font-weight: 600;
    }
    .history-table td {
        color: #cbd5e1;
    }
    .history-empty {
        text-align: center !important;
        color: #64748b !important;
        padding: 2rem !important;
    }
    .cell-fastest {
        color: #4ade80 !important;
        font-weight: bold;
    }
    .cell-slowest {
        color: #f87171 !important;
    }
    .winner-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 6px;
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        font-size: 0.72rem;
        font-weight: 700;
    }
    .history-stats-bar {
        font-family: 'Inter', sans-serif;
        font-size: 0.8rem;
        display: flex;
        gap: 15px;
        color: #fff !important;
    }
    .history-stats-bar .hs-val {
        font-weight: 700;
        color: #38bdf8;
    }

    /* Section fade-in */
    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .fade-in-section {
        animation: fadeSlideUp 0.5s ease-out forwards;
    }
</style>

<script>
    // Force dark background to prevent white flash
    document.body.style.backgroundColor = '#0f172a';
    var appContainer = document.querySelector('.app-container');
    if (appContainer) appContainer.style.backgroundColor = '#0f172a';
    var mainEl = document.querySelector('main');
    if (mainEl) mainEl.style.backgroundColor = '#0f172a';
</script>

<div class="benchmark-hero">
    <div class="container position-relative" style="z-index: 1;">

        <!-- Header -->
        <div class="row align-items-center mb-4 pt-4">
            <div class="col-lg-7 text-center text-lg-start">
                <h1 class="bench-title">
                    <i class="bi bi-speedometer2 me-2"></i>Performans Benchmark
                </h1>
                <p class="bench-subtitle mb-2">
                    TPT (SQL Server) vs CQRS Read Model vs In-Memory Cache — Eşzamanlı Adım Karşılaştırması
                </p>
                <div class="d-flex justify-content-center justify-content-lg-start gap-2 flex-wrap mt-2">
                    <span class="status-badge status-active">
                        <span class="status-dot"></span>
                        SQL Server (TPT)
                    </span>
                    <span class="status-badge status-active">
                        <span class="status-dot" style="background:#34d399;"></span>
                        SQL Read Model (Flat)
                    </span>
                    <span class="status-badge status-active">
                        <span class="status-dot" style="background:#fbbf24;"></span>
                        In-Memory Cache
                    </span>
                </div>
            </div>
            <div class="col-lg-5 text-center text-lg-end mt-3 mt-lg-0">
                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-end gap-2">
                    <div class="d-inline-block text-start">
                        <button id="btnSyncReadModels" class="bench-btn w-100" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);" onclick="syncReadModels(this)">
                            <i class="bi bi-database-fill-down me-1"></i> Read Table Reindex
                        </button>
                        <div id="statusReadModel" class="text-muted small mt-1 text-center text-lg-end" style="font-size: 0.72rem; font-family: 'JetBrains Mono', monospace;">
                            Read Table: Yükleniyor...
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Statistics Cards -->
        <div class="row g-3 mb-4 fade-in-section">
            <div class="col-6 col-lg-3">
                <div class="stat-card" style="--stat-accent: linear-gradient(90deg, #3b82f6, #60a5fa);">
                    <span class="stat-icon"><i class="bi bi-play-circle-fill" style="color: #60a5fa;"></i></span>
                    <div class="stat-value" id="stat-totalRuns">0</div>
                    <div class="stat-label">Toplam Test</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-card" style="--stat-accent: linear-gradient(90deg, #f59e0b, #fbbf24);">
                    <span class="stat-icon"><i class="bi bi-clock-history" style="color: #fbbf24;"></i></span>
                    <div class="stat-value" id="stat-avgSql">—</div>
                    <div class="stat-label">Ort. TPT Süresi</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-card" style="--stat-accent: linear-gradient(90deg, #4ade80, #22c55e);">
                    <span class="stat-icon"><i class="bi bi-trophy-fill" style="color: #4ade80;"></i></span>
                    <div class="stat-value" id="stat-fastestTech">—</div>
                    <div class="stat-label">En Hızlı Teknoloji</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-card" style="--stat-accent: linear-gradient(90deg, #a855f7, #c084fc);">
                    <span class="stat-icon"><i class="bi bi-lightning-charge-fill" style="color: #c084fc;"></i></span>
                    <div class="stat-value" id="stat-speedGain">—</div>
                    <div class="stat-label">Max Cache Kazancı</div>
                </div>
            </div>
        </div>

        <!-- ═══════════════ PERFORMANCE TEST DASHBOARD ═══════════════ -->
        <div class="glass-card mb-4 fade-in-section">
            <div class="row align-items-center mb-4">
                <div class="col-lg-6 text-center text-lg-start">
                    <h3 class="chart-title mb-1">
                        <i class="bi bi-speedometer text-success me-2"></i>Performans Karşılaştırma Testi
                    </h3>
                    <p class="card-desc mb-0">IProductQueryService arayüzündeki tüm servisleri 4 farklı altyapıda test edin.</p>
                </div>
                <!-- Scenario and Parameter Selection -->
                <div class="col-lg-6 mt-3 mt-lg-0">
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-lg-end align-items-sm-center">
                        <div class="flex-grow-1" style="max-width: 320px;">
                            <select id="benchmarkScenarioSelect" class="bench-search-input" onchange="onScenarioChange()" style="height: 40px;">
                                <option value="GetAllProducts" selected>GetAllProductsAsync() — Tüm Ürünler</option>
                                <option value="GetProductsQueryable">GetProductsQueryable() — IQueryable Malzeme</option>
                                <option value="GetProductsByCategory">GetProductsByCategoryAsync(int id)</option>
                                <option value="GetProductsByCategorySlug">GetProductsByCategorySlugAsync(string slug)</option>
                                <option value="GetProductById">GetProductByIdAsync(int id)</option>
                                <option value="GetProductBySlug">GetProductBySlugAsync(string slug)</option>
                                <option value="GetRecentProducts">GetRecentProductsAsync(int count)</option>
                                <option value="GetShowcaseProducts">GetShowcaseProductsAsync() — Vitrin</option>
                                <option value="SearchProducts">SearchProductsAsync(string query)</option>
                                <option value="GetProductImageById">GetProductImageByIdAsync(int id)</option>
                            </select>
                        </div>
                        <div id="paramContainer" class="flex-grow-1" style="max-width: 200px; display: none;">
                            <input type="text" id="benchmarkParamInput" class="bench-search-input" value="" placeholder="Parametre..." style="height: 40px;" />
                            <span id="paramLabel" class="text-muted text-start d-block" style="font-size: 0.7rem; margin-top: 2px;"></span>
                        </div>
                        <button class="bench-btn bench-btn-danger px-4" id="startTestBtn" onclick="runPerformanceTest()" style="height: 40px; font-weight: 700;">
                            <i class="bi bi-play-fill me-1"></i> TESTİ BAŞLAT!
                        </button>
                    </div>
                </div>
            </div>

            <!-- 4 Equal-Sized Grid Cards -->
            <div class="row g-3 mb-2">
                
                <!-- Card 1: SQL Server TPT -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="glass-card h-100 d-flex flex-column justify-content-between p-3" style="border-top: 3px solid #3b82f6;">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-white" style="font-family: 'Outfit', sans-serif; font-size: 0.9rem;"><i class="bi bi-database me-1 text-primary"></i> SQL Server TPT</span>
                                <span id="badge-card-sql" class="badge bg-dark border border-secondary text-secondary">Hazır</span>
                            </div>
                            <div class="text-center my-3">
                                <div id="time-card-sql" class="fs-2 fw-bold text-white mb-1">— ms</div>
                                <div id="count-card-sql" class="text-muted small">— kayıt</div>
                            </div>
                            <!-- Query Container -->
                            <div class="mb-2 text-start">
                                <div class="d-flex justify-content-between align-items-center mb-1">
