@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        // ── State ─────────────────────────────────────────
        const history = [];
        let isTestRunning = false;

        // ── Chart Setup ────────────────────────────────────
        const ctx = document.getElementById('benchmarkChart').getContext('2d');
        const benchChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [],
                datasets: [
                    {
                        label: 'SQL Server TPT (ms)',
                        data: [],
                        backgroundColor: 'rgba(96, 165, 250, 0.7)',
                        borderColor: '#60a5fa',
                        borderWidth: 1,
                        borderRadius: 6,
                        barPercentage: 0.7,
                    },
                    {
                        label: 'SQL Read Model (ms)',
                        data: [],
                        backgroundColor: 'rgba(52, 211, 153, 0.7)',
                        borderColor: '#34d399',
                        borderWidth: 1,
                        borderRadius: 6,
                        barPercentage: 0.7,
                    },
                    {
                        label: 'In-Memory Cache (ms)',
                        data: [],
                        backgroundColor: 'rgba(251, 191, 36, 0.7)',
                        borderColor: '#fbbf24',
                        borderWidth: 1,
                        borderRadius: 6,
                        barPercentage: 0.7,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 800,
                    easing: 'easeOutQuart'
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.9)',
                        titleFont: { family: "'Inter', sans-serif", weight: '600' },
                        bodyFont: { family: "'JetBrains Mono', monospace" },
                        borderColor: 'rgba(148, 163, 184, 0.2)',
                        borderWidth: 1,
                        cornerRadius: 8,
                        padding: 12,
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + ' ms';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#94a3b8', font: { family: "'Inter', sans-serif", size: 11 } },
                        grid: { color: 'rgba(148, 163, 184, 0.06)' }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            color: '#94a3b8',
                            font: { family: "'JetBrains Mono', monospace", size: 11 },
                            callback: function(value) { return value + ' ms'; }
                        },
                        grid: { color: 'rgba(148, 163, 184, 0.06)' }
                    }
                }
            }
        });

        function addToChart(label, sqlMs, sqlFlatMs, cacheMs) {
            benchChart.data.labels.push(label);
            benchChart.data.datasets[0].data.push(sqlMs || 0);
            benchChart.data.datasets[1].data.push(sqlFlatMs || 0);
            benchChart.data.datasets[2].data.push(cacheMs || 0);
            benchChart.update();
        }

        // ── Console Logger ─────────────────────────────────
        function logToConsole(message, type = 'info') {
            const consoleBox = document.getElementById('consoleBox');
            if (!consoleBox) return;
            const timeStr = new Date().toLocaleTimeString('tr-TR');
            const logLine = document.createElement('div');
            logLine.className = `console-line ${type}`;
            logLine.textContent = `[${timeStr}] [${type.toUpperCase()}] ${message}`;
            consoleBox.appendChild(logLine);
            consoleBox.scrollTop = consoleBox.scrollHeight;
        }

        function clearConsole() {
            const consoleBox = document.getElementById('consoleBox');
            if (consoleBox) {
                consoleBox.innerHTML = `<div class="console-line text-muted">[${new Date().toLocaleTimeString('tr-TR')}] [System] Konsol temizlendi. Yeni testler bekleniyor...</div>`;
            }
        }

        // ── Counting Animation ─────────────────────────────
        function animateValue(el, start, end, suffix, duration) {
            const range = end - start;
            const startTime = performance.now();
            function step(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = start + range * eased;
                if (suffix === 'x') {
                    el.textContent = current.toFixed(0) + 'x';
                } else if (suffix === 'ms') {
                    el.textContent = current.toFixed(1) + ' ms';
                } else {
                    el.textContent = Math.round(current);
                }
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        // ── Update Stats ──────────────────────────────────
        function updateStats() {
            document.getElementById('stat-totalRuns').textContent = history.length;

            if (history.length === 0) {
                document.getElementById('stat-avgSql').textContent = '—';
                document.getElementById('stat-fastestTech').textContent = '—';
                document.getElementById('stat-speedGain').textContent = '—';
                document.getElementById('hs-total').textContent = '0';
                document.getElementById('hs-avgSql').textContent = '—';
                return;
            }

            const avgSql = history.reduce((s, h) => s + h.sqlTimeMs, 0) / history.length;
            const avgEl = document.getElementById('stat-avgSql');
            animateValue(avgEl, 0, avgSql, 'ms', 600);

            let fastest = { name: 'SQL TPT', ms: Infinity };
            history.forEach(h => {
                if (h.sqlTimeMs > 0 && h.sqlTimeMs < fastest.ms) fastest = { name: 'SQL TPT', ms: h.sqlTimeMs };
                if (h.sqlReadModelTimeMs > 0 && h.sqlReadModelTimeMs < fastest.ms) fastest = { name: 'Read Model', ms: h.sqlReadModelTimeMs };
                if (h.cacheHotMs > 0 && h.cacheHotMs < fastest.ms) fastest = { name: 'Cache', ms: h.cacheHotMs };
            });
            document.getElementById('stat-fastestTech').textContent = fastest.name;

            const cacheRuns = history.filter(h => h.cacheHotMs > 0 && h.sqlTimeMs > 0);
            if (cacheRuns.length > 0) {
                const lastCache = cacheRuns[cacheRuns.length - 1];
                const ratio = Math.round(lastCache.sqlTimeMs / lastCache.cacheHotMs);
                const gainEl = document.getElementById('stat-speedGain');
                animateValue(gainEl, 0, ratio, 'x', 800);
            } else {
                document.getElementById('stat-speedGain').textContent = '—';
            }

            document.getElementById('hs-total').textContent = history.length;
            document.getElementById('hs-avgSql').textContent = avgSql.toFixed(1) + ' ms';
        }

        function addToHistory(data) {
            const entry = {
                num: history.length + 1,
                scenario: data.scenario,
                sqlTimeMs: data.sqlTimeMs,
                sqlReadModelTimeMs: data.sqlReadModelTimeMs,
                cacheHotMs: data.cacheHotMs,
                count: data.sqlCount || data.cacheCount || 0,
                time: new Date().toLocaleTimeString('tr-TR')
            };

            const times = [];
            if (entry.sqlTimeMs > 0) times.push({ name: 'SQL TPT', ms: entry.sqlTimeMs });
            if (entry.sqlReadModelTimeMs > 0) times.push({ name: 'Read Model', ms: entry.sqlReadModelTimeMs });
            if (entry.cacheHotMs > 0) times.push({ name: 'Cache', ms: entry.cacheHotMs });
            times.sort((a, b) => a.ms - b.ms);
            entry.winner = times[0]?.name || '—';
            entry.slowest = times[times.length - 1]?.name || '—';

            history.push(entry);

            renderHistory();
            updateStats();
        }

        function renderHistory() {
            const body = document.getElementById('historyBody');
            if (history.length === 0) {
                body.innerHTML = `<tr><td colspan="8" class="history-empty"><i class="bi bi-inbox me-1"></i> Henüz test çalıştırılmadı.</td></tr>`;
                return;
            }

            body.innerHTML = history.slice().reverse().map(h => {
                function cellClass(name, ms) {
                    if (!ms || ms === 0) return '';
                    if (name === h.winner) return 'cell-fastest';
                    if (name === h.slowest) return 'cell-slowest';
                    return '';
                }
                function fmt(ms) { return ms && ms > 0 ? ms.toFixed(2) + ' ms' : '—'; }

                return `
                <tr class="history-row">
                    <td>${h.num}</td>
                    <td>${h.scenario}</td>
                    <td class="${cellClass('SQL TPT', h.sqlTimeMs)}">${fmt(h.sqlTimeMs)}</td>
                    <td class="${cellClass('Read Model', h.sqlReadModelTimeMs)}">${fmt(h.sqlReadModelTimeMs)}</td>
                    <td class="${cellClass('Cache', h.cacheHotMs)}">${fmt(h.cacheHotMs)}</td>
                    <td style="color: #94a3b8;">${h.count}</td>
                    <td><span class="winner-badge"><i class="bi bi-trophy-fill text-warning"></i> ${h.winner}</span></td>
                    <td style="color: #64748b; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">${h.time}</td>
                </tr>
                `;
            }).join('');
        }

        function clearHistory() {
            history.length = 0;
            benchChart.data.labels = [];
            benchChart.data.datasets.forEach(d => d.data = []);
            benchChart.update();

            renderHistory();
            updateStats();
            logToConsole("Test geçmişi temizlendi.", "info");
            onScenarioChange();
        }

        async function syncReadModels(btn) {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="bench-spinner"></span> Senkronize ediliyor...';
            btn.disabled = true;
            logToConsole("CQRS Read Model Flat tablosu SQL verileriyle eşitleniyor (Sync)...", "cmd");

            try {
                const resp = await fetch('/Benchmark/SyncReadModels', { method: 'POST' });
                const data = await resp.json();
                if (data.success) {
                    logToConsole(`CQRS Read Model eşitlendi! Aktarılan kayıt: ${data.count}. Süre: ${data.timeMs.toFixed(0)} ms`, "success");
                    alert(`Read Model Senkronizasyonu Tamamlandı! \nSüre: ${data.timeMs.toFixed(0)} ms \nAktarılan Kayıt: ${data.count}`);
                    fetchCounts();
                } else {
                    logToConsole("Sync işlemi başarısız.", "warning");
                    alert('Senkronizasyon başarısız');
                }
            } catch (err) {
                logToConsole(`Eşitlemede hata oluştu: ${err.message}`, "warning");
                alert('Senkronizasyon hatası: ' + err.message);
            }

            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }

        // ── Canlı Durum ve Kayıt Sayısı Gösterimi ───────────
        async function fetchCounts() {
            try {
                const resp = await fetch('/Benchmark/GetIndexStatus');
                if (resp.ok) {
                    const data = await resp.json();
                    updateStatusUI(data);
                }
            } catch (err) {
                console.error("Durum bilgileri çekilemedi:", err);
            }
        }

        function updateStatusUI(data) {
            const { sqlReadModelCount, totalProductsCount } = data;
            
            const statusReadModelEl = document.getElementById('statusReadModel');
            if (statusReadModelEl) {
                if (sqlReadModelCount === 0) {
                    statusReadModelEl.innerHTML = `<span class="text-danger">⚠️ Tablo Boş (0 / ${totalProductsCount})</span>`;
                } else if (sqlReadModelCount !== totalProductsCount) {
                    statusReadModelEl.innerHTML = `<span class="text-warning">⚠️ Eksik Tablo (${sqlReadModelCount} / ${totalProductsCount})</span>`;
                } else {
                    statusReadModelEl.innerHTML = `<span class="text-success">✅ Eşitlendi (${sqlReadModelCount} / ${totalProductsCount})</span>`;
                }
            }
        }

        // ── JSON Veri Gösterimi ve Modal İşlemleri ───────────
        let lastStepData = {};
        let activeTech = 'sql';
        let activeTab = 'query';

        // Custom regex-based JSON syntax highlighter and beautifier
        function syntaxHighlightJson(json) {
            if (!json) return '';
            if (typeof json !== 'string') {
                json = JSON.stringify(json, null, 4);
            }
            // Escape HTML characters
            json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            // Regex to match JSON components
            return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)/g, function (match) {
                let cls = 'json-number';
                if (/^"/.test(match)) {
                    if (/:$/.test(match)) {
                        cls = 'json-key';
                    } else {
                        cls = 'json-string';
                    }
                } else if (/true|false/.test(match)) {
                    cls = 'json-boolean';
                } else if (/null/.test(match)) {
                    cls = 'json-null';
                }
                return '<span class="' + cls + '">' + match + '</span>';
            });
        }

        function openZoomModal(tech, tab) {
            if (!lastStepData || !lastStepData[tech] || !lastStepData[tech].success) return;
            activeTech = tech;
            activeTab = tab;
            
            // Show modal
            const myModal = new bootstrap.Modal(document.getElementById('benchmarkDetailModal'));
            myModal.show();
            
            // Update modal UI
            updateModalContent();
        }

        function switchDetailTab(tab) {
            activeTab = tab;
            updateModalContent();
        }

        function updateModalContent() {
            const res = lastStepData[activeTech];
            if (!res) return;

            const techNames = {
                sql: 'SQL Server TPT',
                flat: 'SQL Read Model',
                cache: 'In-Memory Cache'
            };

            // Update stats on right
            document.getElementById('detail-stat-tech').textContent = techNames[activeTech];
            document.getElementById('detail-stat-time').textContent = `${res.timeMs.toFixed(2)} ms`;
            document.getElementById('detail-stat-count').textContent = `${res.count} kayıt`;

            // Update sub-text of thumbnails to reflect active tech names
            document.getElementById('thumb-query-sub').textContent = activeTech === 'es' ? 'ES Query Body' : 'SQL Sorgusu';
            document.getElementById('thumb-data-sub').textContent = 'Formatlanmış JSON';

            // Toggle active thumbnail styling
            if (activeTab === 'query') {
                document.getElementById('thumb-query').classList.add('active');
                document.getElementById('thumb-data').classList.remove('active');

                // Left pane header
                document.getElementById('detailModalTitleText').textContent = `${techNames[activeTech]} - Sorgu/İstek Detayı`;
                document.getElementById('detailModalLeftIcon').className = 'bi bi-code-slash text-primary me-2';

                // Display query
                document.getElementById('detailModalContent').textContent = res.sql || 'Sorgu bulunamadı.';
            } else {
                document.getElementById('thumb-query').classList.remove('active');
                document.getElementById('thumb-data').classList.add('active');

                // Left pane header
                document.getElementById('detailModalTitleText').textContent = `${techNames[activeTech]} - Gelen JSON Verisi`;
                document.getElementById('detailModalLeftIcon').className = 'bi bi-braces text-warning me-2';

                // Display beautified JSON
                document.getElementById('detailModalContent').innerHTML = syntaxHighlightJson(res.data);
            }
        }

        function copyDetailText() {
            const res = lastStepData[activeTech];
            if (!res) return;
            let text = '';
            if (activeTab === 'query') {
                text = res.sql || '';
            } else {
                text = JSON.stringify(res.data, null, 4);
            }
            navigator.clipboard.writeText(text);
            alert("Veri panoya kopyalandı!");
        }

        // ── Performance Test Logic ────────────────────────
        function onScenarioChange() {
            const scenario = document.getElementById('benchmarkScenarioSelect').value;
            const paramContainer = document.getElementById('paramContainer');
            const paramInput = document.getElementById('benchmarkParamInput');
            const paramLabel = document.getElementById('paramLabel');

            let showParam = false;
            let defaultValue = "";
            let labelText = "";

            switch (scenario) {
                case "GetProductsByCategory":
                    showParam = true;
                    defaultValue = "11";
                    labelText = "Kategori ID (Varsayılan: 11)";
                    break;
                case "GetProductsByCategorySlug":
                    showParam = true;
                    defaultValue = "avci-ucaklari";
                    labelText = "Kategori Slug (Varsayılan: 'avci-ucaklari')";
                    break;
                case "GetProductById":
                    showParam = true;
                    defaultValue = "1";
                    labelText = "Ürün ID (Varsayılan: 1)";
                    break;
                case "GetProductBySlug":
                    showParam = true;
                    defaultValue = "f-16-fighting-falcon";
                    labelText = "Ürün Slug (Varsayılan: 'f-16-fighting-falcon')";
                    break;
                case "GetRecentProducts":
                    showParam = true;
                    defaultValue = "6";
                    labelText = "Ürün Adedi (Varsayılan: 6)";
                    break;
                case "SearchProducts":
                    showParam = true;
                    defaultValue = "hava";
                    labelText = "Arama Terimi (Varsayılan: 'hava')";
                    break;
                case "GetProductImageById":
                    showParam = true;
                    defaultValue = "1";
                    labelText = "Resim ID (Varsayılan: 1)";
                    break;
                default:
                    showParam = false;
                    defaultValue = "";
                    labelText = "";
                    break;
            }

            if (showParam) {
                paramContainer.style.display = 'block';
                paramInput.value = defaultValue;
                paramLabel.textContent = labelText;
            } else {
                paramContainer.style.display = 'none';
                paramInput.value = "";
                paramLabel.textContent = "";
            }

            // Reset card UI
            const techs = ['sql', 'flat', 'cache'];
            techs.forEach(t => {
                document.getElementById(`time-card-${t}`).textContent = '— ms';
                document.getElementById(`time-card-${t}`).className = 'fs-2 fw-bold text-white mb-1';
                document.getElementById(`count-card-${t}`).textContent = '— kayıt';
                document.getElementById(`query-card-${t}`).textContent = '';
                
                const dataCard = document.getElementById(`data-card-${t}`);
                if (dataCard) dataCard.textContent = '';

                const btnZoomQuery = document.getElementById(`btn-zoom-query-${t}`);
                if (btnZoomQuery) btnZoomQuery.style.display = 'none';

                const btnZoomData = document.getElementById(`btn-zoom-data-${t}`);
                if (btnZoomData) btnZoomData.style.display = 'none';
                
                const badge = document.getElementById(`badge-card-${t}`);
                badge.textContent = 'Hazır';
                badge.className = 'badge bg-dark border border-secondary text-secondary';
            });

            document.getElementById('battleAnnouncement').classList.add('d-none');
        }

        async function runPerformanceTest() {
            if (isTestRunning) return;
            isTestRunning = true;

            const btn = document.getElementById('startTestBtn');
            const scenario = document.getElementById('benchmarkScenarioSelect').value;
            const parameter = document.getElementById('benchmarkParamInput').value;
            const announce = document.getElementById('battleAnnouncement');

            btn.disabled = true;
            btn.innerHTML = '<span class="bench-spinner"></span> Test Ediliyor...';
            announce.classList.add('d-none');

            const techs = ['sql', 'flat', 'cache'];
            
            // Clear and set cards to running
            techs.forEach(t => {
                document.getElementById(`time-card-${t}`).textContent = 'Test Ediliyor...';
                document.getElementById(`time-card-${t}`).className = 'fs-4 text-warning mb-1';
                document.getElementById(`count-card-${t}`).textContent = '—';
                document.getElementById(`query-card-${t}`).textContent = '';
                
                const dataCard = document.getElementById(`data-card-${t}`);
                if (dataCard) dataCard.textContent = '';

                const btnZoomQuery = document.getElementById(`btn-zoom-query-${t}`);
                if (btnZoomQuery) btnZoomQuery.style.display = 'none';

                const btnZoomData = document.getElementById(`btn-zoom-data-${t}`);
                if (btnZoomData) btnZoomData.style.display = 'none';

                const badge = document.getElementById(`badge-card-${t}`);
                badge.textContent = 'Test Ediliyor...';
                badge.className = 'badge bg-warning border border-warning text-dark';
            });

            logToConsole(`Performans Testi Başlatıldı! Senaryo: ${scenario}, Parametre: ${parameter || 'Yok'}`, "cmd");

            lastStepData = {};
            const startTime = performance.now();

            // Run parallel fetch calls
            const promises = techs.map(async (tech) => {
                try {
                    const formData = new FormData();
                    formData.append('scenario', scenario);
                    formData.append('tech', tech);
                    formData.append('parameter', parameter);

                    const resp = await fetch('/Benchmark/RunBenchmarkStep', {
                        method: 'POST',
                        body: formData
                    });

                    if (!resp.ok) {
                        throw new Error(`HTTP Hata: ${resp.status}`);
                    }

                    const res = await resp.json();
                    lastStepData[tech] = res;

                    if (res.success) {
                        // Update UI for this technology immediately!
                        document.getElementById(`time-card-${tech}`).textContent = `${res.timeMs.toFixed(2)} ms`;
                        document.getElementById(`time-card-${tech}`).className = 'fs-2 fw-bold text-success mb-1';
                        document.getElementById(`count-card-${tech}`).textContent = `${res.count} kayıt`;
                        document.getElementById(`query-card-${tech}`).textContent = res.sql || 'Sorgu bulunamadı.';
                        
                        const dataCard = document.getElementById(`data-card-${tech}`);
                        if (dataCard) {
                            dataCard.innerHTML = syntaxHighlightJson(res.data);
                        }

                        const btnZoomQuery = document.getElementById(`btn-zoom-query-${tech}`);
                        if (btnZoomQuery) btnZoomQuery.style.display = 'inline-block';

                        const btnZoomData = document.getElementById(`btn-zoom-data-${tech}`);
                        if (btnZoomData) btnZoomData.style.display = 'inline-block';

                        const badge = document.getElementById(`badge-card-${tech}`);
                        badge.textContent = 'Tamamlandı';
                        badge.className = 'badge bg-success border border-success text-white';

                        logToConsole(`${tech.toUpperCase()} tamamlandı: ${res.timeMs.toFixed(2)} ms`, "success");
                    } else {
                        throw new Error(res.errorMessage || 'Başarısız oldu.');
                    }
                } catch (err) {
                    lastStepData[tech] = { success: false, errorMessage: err.message };
                    document.getElementById(`time-card-${tech}`).textContent = 'Hata';
                    document.getElementById(`time-card-${tech}`).className = 'fs-2 fw-bold text-danger mb-1';
                    document.getElementById(`count-card-${tech}`).textContent = '—';
                    document.getElementById(`query-card-${tech}`).textContent = err.message;
                    
                    const dataCard = document.getElementById(`data-card-${tech}`);
                    if (dataCard) dataCard.textContent = '';

                    const btnZoomQuery = document.getElementById(`btn-zoom-query-${tech}`);
                    if (btnZoomQuery) btnZoomQuery.style.display = 'none';

                    const btnZoomData = document.getElementById(`btn-zoom-data-${tech}`);
                    if (btnZoomData) btnZoomData.style.display = 'none';

                    const badge = document.getElementById(`badge-card-${tech}`);
                    badge.textContent = 'Hata';
                    badge.className = 'badge bg-danger border border-danger text-white';

                    logToConsole(`${tech.toUpperCase()} hatası: ${err.message}`, "warning");
                }
            });

            // Wait for all steps to finish
            await Promise.all(promises);

            // Add to chart and history
            const sqlRes = lastStepData['sql'];
            const flatRes = lastStepData['flat'];
            const cacheRes = lastStepData['cache'];

            addToChart(
                scenario + (parameter ? ` (${parameter})` : ''),
                sqlRes?.success ? sqlRes.timeMs : 0,
                flatRes?.success ? flatRes.timeMs : 0,
                cacheRes?.success ? cacheRes.timeMs : 0
            );

            addToHistory({
                scenario: scenario + (parameter ? ` (${parameter})` : ''),
                sqlTimeMs: sqlRes?.success ? sqlRes.timeMs : 0,
                sqlReadModelTimeMs: flatRes?.success ? flatRes.timeMs : 0,
                cacheHotMs: cacheRes?.success ? cacheRes.timeMs : 0,
                sqlCount: sqlRes?.success ? sqlRes.count : 0,
                cacheCount: cacheRes?.success ? cacheRes.count : 0
            });

            // Show announcement summary
            let winnerKey = '';
            let minVal = Infinity;
            for (let k in lastStepData) {
                const item = lastStepData[k];
                if (item && item.success && item.timeMs > 0 && item.timeMs < minVal) {
                    minVal = item.timeMs;
                    winnerKey = k;
                }
            }

            const techNames = {
                sql: 'SQL Server TPT',
                flat: 'SQL Read Model',
                cache: 'In-Memory Cache'
            };

            if (winnerKey) {
                announce.className = 'battle-announcement text-center animate__animated animate__fadeIn mt-3';
                announce.classList.remove('d-none');
                
                let comparisonText = '';
                let maxVal = 0;
                let loserKey = '';
                for (let k in lastStepData) {
                    const item = lastStepData[k];
                    if (item && item.success && item.timeMs > 0 && item.timeMs > maxVal) {
                        maxVal = item.timeMs;
                        loserKey = k;
                    }
                }

                if (loserKey && winnerKey !== loserKey) {
                    const ratio = (lastStepData[loserKey].timeMs / lastStepData[winnerKey].timeMs).toFixed(1);
                    comparisonText = `<strong>${techNames[winnerKey]}</strong>, en yavaş olan <strong>${techNames[loserKey]}</strong> karşısında <strong>${ratio}x kat daha hızlı</strong> performans gösterdi.`;
                }

                announce.innerHTML = `
                    <div style="font-size: 1.1rem; font-weight: 700; color: #4ade80;">
                        🎉 Test Tamamlandı! En Hızlı Altyapı: ${techNames[winnerKey]} (${lastStepData[winnerKey].timeMs.toFixed(2)} ms)
                    </div>
                    <div class="mt-2" style="font-size: 0.88rem; color: #cbd5e1;">
                        ${comparisonText}
                    </div>
                `;
            }

            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-play-fill me-1"></i> TESTİ BAŞLAT!';
            isTestRunning = false;
        }

        // Initialize view states and fetch statuses
        onScenarioChange();
        fetchCounts();
    </script>
}
