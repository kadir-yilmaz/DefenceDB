@{
    var currentCategory = ViewBag.CurrentCategory as DefenceDB.EL.Models.Category;
    var filterAttributes = ViewBag.FilterAttributes as List<DefenceDB.EL.Models.CategoryAttribute>;
}

@if (filterAttributes != null && filterAttributes.Any())
{
    <form method="get" action="@Url.Action("Index", "Product")">
        <input type="hidden" name="categorySlug" value="@(currentCategory?.Slug)" />
        <input type="hidden" name="country" value="@ViewBag.CurrentCountry" />
        <input type="hidden" name="search" value="@ViewBag.CurrentSearch" />
        
        @foreach (var attr in filterAttributes)
        {
            var currentVal = Context.Request.Query[attr.Name].ToString();
            
            <div class="mb-3">
                <label class="form-label text-secondary-theme small">@attr.DisplayName</label>
                
                @if (attr.Type == DefenceDB.EL.Models.AttributeType.Boolean)
                {
                    <select name="@attr.Name" class="form-select form-select-sm bg-theme text-primary-theme border-theme" onchange="sessionStorage.setItem('filterScroll', window.scrollY); this.form.submit()">
                        <option value="">Tümü</option>
                        <option value="true" selected="@(currentVal == "true" ? "selected" : null)">Evet</option>
                        <option value="false" selected="@(currentVal == "false" ? "selected" : null)">Hayır</option>
                    </select>
                }
                else if (attr.Type == DefenceDB.EL.Models.AttributeType.Dropdown && attr.Options != null && attr.Options.Any())
                {
                    <select name="@attr.Name" class="form-select form-select-sm bg-theme text-primary-theme border-theme" onchange="sessionStorage.setItem('filterScroll', window.scrollY); this.form.submit()">
                        <option value="">Tümü</option>
                        @foreach(var opt in attr.Options)
                        {
                            <option value="@opt" selected="@(currentVal == opt ? "selected" : null)">@opt</option>
                        }
                    </select>
                }
                else if (attr.Type == DefenceDB.EL.Models.AttributeType.Number)
                {
                    <input type="number" step="any" name="@attr.Name" class="form-control form-control-sm bg-theme text-primary-theme border-theme" placeholder="Sayı girin..." value="@currentVal" onchange="sessionStorage.setItem('filterScroll', window.scrollY); this.form.submit()" />
                }
                else
                {
                    <input type="text" name="@attr.Name" class="form-control form-control-sm bg-theme text-primary-theme border-theme" placeholder="Aranacak değer..." value="@currentVal" onchange="sessionStorage.setItem('filterScroll', window.scrollY); this.form.submit()" />
                }
            </div>
        }
        
        @{
            var clearUrl = Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch });
        }
        <a href="@clearUrl" class="btn btn-outline-secondary btn-sm w-100 mt-2" onclick="sessionStorage.setItem('filterScroll', window.scrollY);">Temizle</a>
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var scroll = sessionStorage.getItem('filterScroll');
            if (scroll !== null) {
                window.scrollTo({ top: parseInt(scroll), behavior: 'instant' });
                sessionStorage.removeItem('filterScroll');
            }
        });
    </script>
}
