@model List<DefenseProduct>
@{
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var currentCategory = ViewBag.CurrentCategory as Category;
    var productCounts = ViewBag.CategoryCounts as Dictionary<int, int> ?? new Dictionary<int, int>();

    // Thumbnail helper: /images/products/x.webp -> /images/thumbs/x.webp
    Func<string, string> toThumb = path => {
        if (string.IsNullOrEmpty(path)) return "/images/default.jpg";
        var fileName = System.IO.Path.GetFileName(path);
        return $"/images/thumbs/{fileName}";
    };

    // DisplayName veya Temiz İsim Formatlayıcı
    string GetSpecLabel(string rawKey)
    {
        if (string.IsNullOrWhiteSpace(rawKey)) return "";
        var cleanKey = rawKey.StartsWith("Bool_", StringComparison.OrdinalIgnoreCase) ? rawKey.Substring(5) : rawKey;
        
        var catAttrs = ViewBag.FilterAttributes as List<DefenceDB.EL.Models.CategoryAttribute>;
        if (catAttrs != null)
        {
            var match = catAttrs.FirstOrDefault(a => string.Equals(a.Name, cleanKey, StringComparison.OrdinalIgnoreCase) || string.Equals(a.Name, rawKey, StringComparison.OrdinalIgnoreCase));
            if (match != null && !string.IsNullOrEmpty(match.DisplayName))
                return match.DisplayName;
        }

        var clean = System.Text.RegularExpressions.Regex.Replace(cleanKey, "([a-z])([A-Z])", "$1 $2");
        if (clean.EndsWith(" Km", StringComparison.OrdinalIgnoreCase)) clean = clean[..^3] + " (km)";
        else if (clean.EndsWith(" Ft", StringComparison.OrdinalIgnoreCase)) clean = clean[..^3] + " (ft)";
        else if (clean.EndsWith(" M", StringComparison.OrdinalIgnoreCase)) clean = clean[..^2] + " (m)";
        else if (clean.EndsWith(" Kg", StringComparison.OrdinalIgnoreCase)) clean = clean[..^3] + " (kg)";
        return clean;
    }

    // Özyinelemeli (Recursive) Kategori Ürün Sayısı Toplayıcı (Rollup Count)
    int GetCategoryRollupCount(Category cat)
    {
        int direct = productCounts.GetValueOrDefault(cat.Id, 0);
        int childrenSum = (cat.SubCategories != null && cat.SubCategories.Any()) 
            ? cat.SubCategories.Sum(sc => GetCategoryRollupCount(sc)) 
            : 0;
        return direct + childrenSum;
    }

    var totalProductCount = categories.Sum(cat => GetCategoryRollupCount(cat));

    // Aktif kategorinin bu dalda (branch) olup olmadığını kontrol eden fonksiyon
    bool IsCategoryInBranch(Category cat, int? activeId)
    {
        if (activeId == null) return false;
        if (cat.Id == activeId.Value) return true;
        if (cat.SubCategories != null && cat.SubCategories.Any())
        {
            return cat.SubCategories.Any(sc => IsCategoryInBranch(sc, activeId));
        }
        return false;
    }

    // Sınırsız Derinlikte Kategori Ağacı Oluşturucu (N-Level Recursive Category Tree Renderer)
    void RenderCategoryTree(IEnumerable<Category> subCats, int depth = 1)
    {
        if (subCats == null || !subCats.Any()) return;
        
        <div class="ps-2 border-start border-theme ms-2 mb-1 mt-1">
            @foreach (var sub in subCats)
            {
                var subRollupCount = GetCategoryRollupCount(sub);
                var isSubBranch = IsCategoryInBranch(sub, currentCategory?.Id);
                var isSubActive = currentCategory?.Id == sub.Id;
                
                <a href="@Url.Action("Index", "Product", new { categorySlug = sub.Slug, country = ViewBag.CurrentCountry })" 
                   class="sidebar-category-link @(isSubActive ? "active text-warning fw-bold" : (isSubBranch ? "text-primary-theme fw-semibold" : "text-secondary-theme")) d-flex justify-content-between align-items-center py-1 mt-1" 
                   style="font-size: @(Math.Max(0.78, 0.88 - (depth * 0.02)))rem;">
                    <span class="text-truncate" style="max-width: 80%;">
                        @if (!string.IsNullOrEmpty(sub.IconClass))
                        {
                            <i class="@sub.IconClass me-1" style="font-size: 0.75rem;"></i>
                        }
                        @sub.Name
                    </span>
                    <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme ms-1" style="font-size: 0.7rem;">@subRollupCount</span>
                </a>

                if (isSubBranch && sub.SubCategories != null && sub.SubCategories.Any())
                {
                    RenderCategoryTree(sub.SubCategories, depth + 1);
                }
            }
        </div>
    }
}

<div class="container py-5">
<link rel="stylesheet" href="~/css/product-list.css" asp-append-version="true" />
@* Mobile Offcanvas *@
    <div class="offcanvas offcanvas-start bg-theme" tabindex="-1" id="mobileFilterPanel" aria-labelledby="mobileFilterPanelLabel" style="width: 75%;">
        <div class="offcanvas-header border-bottom border-theme">
            <h5 class="offcanvas-title text-primary-theme" id="mobileFilterPanelLabel">
                <i class="bi bi-funnel-fill text-warning me-2"></i> Filtreler
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            @* Kategori Listesi (Mobil) *@
            <div class="bg-theme-card border border-theme rounded-4 p-3 shadow-sm mb-4">
                <h6 class="text-primary-theme mb-3 pb-2 border-bottom border-theme d-flex align-items-center gap-2">
                    <i class="bi bi-grid-3x3-gap-fill text-warning"></i>
                    <span>Tüm Kategoriler</span>
                </h6>
                <div class="category-list">
                    <a href="@Url.Action("Index", "Product", new { country = ViewBag.CurrentCountry })" class="sidebar-category-link @(currentCategory == null ? "active" : "") d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-list-stars me-2"></i>Tüm Ürünler</span>
                        <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme">@totalProductCount</span>
                    </a>
                    @foreach (var cat in categories)
                    {
                        var mRootCount = GetCategoryRollupCount(cat);
                        var mIsRootBranch = IsCategoryInBranch(cat, currentCategory?.Id);
                        <a href="@Url.Action("Index", "Product", new { categorySlug = cat.Slug, country = ViewBag.CurrentCountry })" 
                           class="sidebar-category-link @(mIsRootBranch ? "active fw-bold" : "") d-flex justify-content-between align-items-center">
                            <span>@cat.Name</span>
                            <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme">@mRootCount</span>
                        </a>
                        if (mIsRootBranch && cat.SubCategories != null && cat.SubCategories.Any())
                        {
                            RenderCategoryTree(cat.SubCategories, 1);
                        }
                    }
                </div>
            </div>

            @* Ozellik Filtreleri (Mobil) *@
            @if (ViewBag.FilterProperties != null && ((List<System.Reflection.PropertyInfo>)ViewBag.FilterProperties).Any())
            {
                <div class="bg-theme-card border border-theme rounded-4 p-3 shadow-sm">
                    <h6 class="text-primary-theme mb-3 pb-2 border-bottom border-theme d-flex align-items-center gap-2">
                        <i class="bi bi-sliders text-warning"></i>
                        <span>Özellik Filtreleri</span>
                    </h6>
                    @await Html.PartialAsync("_FilterForm")
                </div>
            }
        </div>
    </div>

    <div class="row">
        <!-- PC Sidebar (SADECE KATEGORİLER) -->
        <div class="col-lg-3 d-none d-lg-block mb-4 mb-lg-0 pe-lg-3">
            <div class="sidebar-sticky">
                <div class="bg-theme-card border border-theme rounded-4 p-4 shadow-sm">
                    <h5 class="text-primary-theme mb-4 pb-2 border-bottom border-theme d-flex align-items-center gap-2">
                        <i class="bi bi-grid-3x3-gap-fill text-warning"></i>
                        <span>Tüm Kategoriler</span>
                    </h5>
                    <div class="category-list">
                        <a href="@Url.Action("Index", "Product", new { country = ViewBag.CurrentCountry })" class="sidebar-category-link @(currentCategory == null ? "active" : "") d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-list-stars me-2"></i>Tüm Ürünler</span>
                            <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme">@totalProductCount</span>
                        </a>
                        
                        @foreach (var cat in categories)
                        {
                            var rootCount = GetCategoryRollupCount(cat);
                            var isRootBranch = IsCategoryInBranch(cat, currentCategory?.Id);
                            
                            <a href="@Url.Action("Index", "Product", new { categorySlug = cat.Slug, country = ViewBag.CurrentCountry })" 
                               class="sidebar-category-link @(isRootBranch ? "active fw-bold" : "") d-flex justify-content-between align-items-center">
                                <span>@cat.Name</span>
                                <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme">@rootCount</span>
                            </a>

                            if (isRootBranch && cat.SubCategories != null && cat.SubCategories.Any())
                            {
                                RenderCategoryTree(cat.SubCategories, 1);
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content (Top Filters & Products List/Grid) -->
        <div class="col-lg-9">
            
            <!-- Top Header & Comprehensive Filter Control Panel -->
                <!-- Row 1: Category Title, Category Drawer Button & Sorting Dropdown -->
                <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-3.5">
                    <!-- Sol Taraf: Kategori Başlığı ve Sayısı -->
                    <div>
                        @if (currentCategory != null)
                        {
                            <h3 class="text-primary-theme fw-bold mb-0 d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                @if (!string.IsNullOrEmpty(currentCategory.IconClass))
                                {
                                    <i class="@currentCategory.IconClass text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-shield-fill text-warning"></i>
                                }
                                <span>@currentCategory.Name</span>
                                <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme fs-7 ms-1 font-outfit">@Model.Count Ürün</span>
                            </h3>
                        }
                        else
                        {
                            <h3 class="text-primary-theme fw-bold mb-0 d-flex align-items-center gap-2" style="font-size: 1.25rem;">
                                <i class="bi bi-shield-fill text-warning"></i> Tüm Savunma Ürünleri
                                <span class="badge bg-theme text-secondary-theme rounded-pill border border-theme fs-7 ms-1 font-outfit">@totalProductCount Ürün</span>
                            </h3>
                        }
                    </div>

                    <!-- Sağ Taraf / Mobil Satır: [Kategoriler] (Sol) & [Sıralama] (Sağ) -->
                    <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-3 w-100 w-md-auto mt-2.5 mt-md-0">
                        <!-- Mobil/Tablet Kategori Çekmecesi Tetikleyici -->
                        <button class="btn btn-warning fw-bold text-dark rounded-pill px-3 py-2 d-lg-none d-inline-flex align-items-center gap-2 shadow-sm btn-category-pulse font-outfit" 
                                type="button" 
                                data-bs-toggle="offcanvas" 
                                data-bs-target="#mobileFilterPanel" 
                                aria-controls="mobileFilterPanel"
                                style="font-size: 0.86rem;">
                            <i class="bi bi-grid-fill text-dark me-0.5"></i>
                            <span>Kategoriler</span>
                        </button>

                        <!-- Sıralama Dropdown -->
                        <div class="dropdown">
                            <button class="btn bg-theme-card border border-theme text-primary-theme dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.86rem;">
                                <i class="bi bi-sort-down text-warning"></i>
                                <span class="fw-semibold font-outfit">
                                    @{
                                        var sortLabel = "Sıralama (En Yeni)";
                                        if (!string.IsNullOrEmpty(ViewBag.CurrentSortBy))
                                        {
                                            if (ViewBag.CurrentSortBy == "name_asc") sortLabel = "İsim (A-Z)";
                                            else if (ViewBag.CurrentSortBy == "name_desc") sortLabel = "İsim (Z-A)";
                                            else if (ViewBag.CurrentSortBy == "date_asc") sortLabel = "En Eski";
                                            else if (ViewBag.CurrentSortBy == "country_asc") sortLabel = "Ülke (A-Z)";
                                            else if (ViewBag.CurrentSortBy == "manufacturer_asc") sortLabel = "Üretici (A-Z)";
                                            else if (ViewBag.CurrentSortBy.StartsWith("spec_desc:")) sortLabel = ViewBag.CurrentSortBy.Substring(10) + " (Azalan)";
                                            else if (ViewBag.CurrentSortBy.StartsWith("spec_asc:")) sortLabel = ViewBag.CurrentSortBy.Substring(9) + " (Artan)";
                                        }
                                    }
                                    @sortLabel
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end bg-theme-card border-theme shadow-lg" style="font-size: 0.86rem; max-height: 400px; overflow-y: auto;">
                                <li><a class="dropdown-item text-primary-theme @(string.IsNullOrEmpty(ViewBag.CurrentSortBy) || ViewBag.CurrentSortBy == "date_desc" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = "date_desc" })"><i class="bi bi-calendar-check me-2"></i>En Yeni</a></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == "date_asc" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = "date_asc" })"><i class="bi bi-calendar me-2"></i>En Eski</a></li>
                                <li><hr class="dropdown-divider border-theme"></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == "name_asc" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = "name_asc" })"><i class="bi bi-sort-alpha-down me-2"></i>İsim (A-Z)</a></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == "name_desc" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = "name_desc" })"><i class="bi bi-sort-alpha-down-alt me-2"></i>İsim (Z-A)</a></li>
                                <li><hr class="dropdown-divider border-theme"></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == "country_asc" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = "country_asc" })"><i class="bi bi-globe me-2"></i>Ülke (A-Z)</a></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == "manufacturer_asc" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = "manufacturer_asc" })"><i class="bi bi-building me-2"></i>Üretici (A-Z)</a></li>
                                
                                @{
                                    var allCategoryAttrs = ViewBag.FilterAttributes as List<DefenceDB.EL.Models.CategoryAttribute>;
                                }
                                @if (allCategoryAttrs != null && allCategoryAttrs.Any())
                                {
                                    var sortableAttrs = allCategoryAttrs.Where(a => a.Type == DefenceDB.EL.Models.AttributeType.Number || a.DisplayName.Contains("(kg)") || a.DisplayName.Contains("(km)") || a.DisplayName.Contains("Mach") || a.DisplayName.Contains("Hız") || a.DisplayName.Contains("Menzil") || a.DisplayName.Contains("Ağırlık") || a.DisplayName.Contains("Başlığı")).ToList();
                                    if (!sortableAttrs.Any()) sortableAttrs = allCategoryAttrs.Take(5).ToList();

                                    if (sortableAttrs.Any())
                                    {
                                        <li><hr class="dropdown-divider border-theme"></li>
                                        <li class="dropdown-header text-secondary-theme fs-8 text-uppercase fw-bold px-3 py-1">Ek Özellik Sıralamaları</li>
                                        @foreach (var numAttr in sortableAttrs)
                                        {
                                            var keyDesc = $"spec_desc:{numAttr.Name}";
                                            var keyAsc = $"spec_asc:{numAttr.Name}";
                                            <li>
                                                <a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == keyDesc ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = keyDesc })">
                                                    <i class="bi bi-sort-numeric-down-alt me-2 text-warning"></i>@numAttr.DisplayName (Azalan)
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-primary-theme @(ViewBag.CurrentSortBy == keyAsc ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, viewMode = ViewBag.CurrentViewMode, sortBy = keyAsc })">
                                                    <i class="bi bi-sort-numeric-down me-2 text-warning"></i>@numAttr.DisplayName (Artan)
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                    </div>
                </div>

                <!-- Row 2: Comprehensive Top Filter Bar (Ülkeler, Durum, Ek Attribute'lar) -->
                @{
                    var filterAttrs = ViewBag.FilterAttributes as List<DefenceDB.EL.Models.CategoryAttribute>;
                    bool isAnyFilterActive = !string.IsNullOrEmpty(ViewBag.CurrentStatus) || 
                                             !string.IsNullOrEmpty(ViewBag.CurrentSearch) || 
                                             !string.IsNullOrEmpty(ViewBag.CurrentManufacturer) || 
                                             !string.IsNullOrEmpty(ViewBag.CurrentSortBy) ||
                                             (filterAttrs != null && filterAttrs.Any(a => 
                                                 !string.IsNullOrEmpty(Context.Request.Query[a.Name]) || 
                                                 !string.IsNullOrEmpty(Context.Request.Query[a.Name + "_min"]) || 
                                                 !string.IsNullOrEmpty(Context.Request.Query[a.Name + "_max"])));
                }
                <div class="top-filter-bar bg-theme-card border border-theme rounded-4 p-3 shadow-sm mt-3">
                    <form method="get" action="@Url.Action("Index", "Product")" id="topFilterForm" class="d-flex flex-wrap align-items-center gap-2">
                        <input type="hidden" name="categorySlug" value="@(currentCategory?.Slug)" />
                        <input type="hidden" name="search" value="@ViewBag.CurrentSearch" />
                        <input type="hidden" name="sortBy" value="@ViewBag.CurrentSortBy" />

                        <!-- 1. Ülke Filtresi Dropdown -->
                        <div class="dropdown">
                            <button class="btn bg-theme border border-theme text-primary-theme dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.86rem;">
                                @if(!string.IsNullOrEmpty(ViewBag.CurrentCountry))
                                {
                                    var flagUrlBtn = "https://flagcdn.com/w20/" + ((List<DefenceDB.WebUI.Models.CountryHelper.CountryItem>)ViewBag.CountriesList).FirstOrDefault(c => c.Name == ViewBag.CurrentCountry)?.Code + ".png";
                                    <img src="@flagUrlBtn" alt="@ViewBag.CurrentCountry" style="width:16px; height:auto; border-radius: 2px;" onerror="this.style.display='none';" />
                                    <span class="fw-bold">@ViewBag.CurrentCountry</span>
                                }
                                else
                                {
                                    <i class="bi bi-globe text-warning"></i>
                                    <span>Tüm Ülkeler</span>
                                }
                            </button>
                            <ul class="dropdown-menu bg-theme-card border-theme shadow-lg" style="max-height: 350px; overflow-y: auto; font-size: 0.86rem;">
                                <li>
                                    <a class="dropdown-item text-primary-theme d-flex align-items-center gap-2 @(string.IsNullOrEmpty(ViewBag.CurrentCountry) ? "active bg-warning text-dark" : "")" 
                                       href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, sortBy = ViewBag.CurrentSortBy, status = ViewBag.CurrentStatus })">
                                        <i class="bi bi-globe text-muted"></i> Tüm Ülkeler
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-theme"></li>
                                @foreach (var c in ViewBag.CountriesList as List<DefenceDB.WebUI.Models.CountryHelper.CountryItem> ?? new List<DefenceDB.WebUI.Models.CountryHelper.CountryItem>())
                                {
                                    var flagUrl = "https://flagcdn.com/w20/" + c.Code + ".png";
                                    <li>
                                        <a class="dropdown-item text-primary-theme d-flex align-items-center gap-2 @(string.Equals(ViewBag.CurrentCountry, c.Name, StringComparison.OrdinalIgnoreCase) ? "active bg-warning text-dark" : "bg-theme-hover")" 
                                           href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = c.Name, sortBy = ViewBag.CurrentSortBy, status = ViewBag.CurrentStatus })">
                                            <img src="@flagUrl" alt="@c.Name" style="width: 16px; height: auto; border-radius: 2px;" />
                                            @c.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>

                        <!-- 2. Envanter Durumu Dropdown -->
                        <div class="dropdown">
                            <button class="btn bg-theme border border-theme text-primary-theme dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.86rem;">
                                <i class="bi bi-patch-check-fill text-warning"></i>
                                <span>
                                    @(ViewBag.CurrentStatus switch {
                                        "Active" => "Aktif Kullanımda",
                                        "In Development" => "Geliştirme Aşamasında",
                                        "Retired" => "Emekliye Ayrılmış",
                                        _ => "Tüm Durumlar"
                                    })
                                </span>
                            </button>
                            <ul class="dropdown-menu bg-theme-card border-theme shadow-lg" style="font-size: 0.86rem;">
                                <li><a class="dropdown-item text-primary-theme @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, sortBy = ViewBag.CurrentSortBy })">Tüm Durumlar</a></li>
                                <li><hr class="dropdown-divider border-theme"></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentStatus == "Active" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, sortBy = ViewBag.CurrentSortBy, status = "Active" })"><span class="badge bg-success me-2">●</span>Aktif Kullanımda</a></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentStatus == "In Development" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, sortBy = ViewBag.CurrentSortBy, status = "In Development" })"><span class="badge bg-info text-dark me-2">●</span>Geliştirme Aşamasında</a></li>
                                <li><a class="dropdown-item text-primary-theme @(ViewBag.CurrentStatus == "Retired" ? "active bg-warning text-dark" : "")" href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, sortBy = ViewBag.CurrentSortBy, status = "Retired" })"><span class="badge bg-secondary me-2">●</span>Emekliye Ayrılmış</a></li>
                            </ul>
                        </div>

                        <!-- 3. Dynamic Category Attributes (Ek Özellik Filtreleri) -->
                        @if (filterAttrs != null && filterAttrs.Any())
                        {
                            foreach (var attr in filterAttrs)
                            {
                                if (attr.Type == DefenceDB.EL.Models.AttributeType.Number)
                                {
                                    var minKey = attr.Name + "_min";
                                    var maxKey = attr.Name + "_max";
                                    var currentMinVal = Context.Request.Query[minKey].ToString();
                                    var currentMaxVal = Context.Request.Query[maxKey].ToString();
                                    var hasNumberVal = !string.IsNullOrEmpty(currentMinVal) || !string.IsNullOrEmpty(currentMaxVal);

                                    <div class="dropdown">
                                        <button class="btn bg-theme border @(hasNumberVal ? "border-warning text-warning fw-bold" : "border-theme text-primary-theme") dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.86rem;">
                                            <i class="bi bi-hash text-warning"></i>
                                            <span>
                                                @if (hasNumberVal)
                                                {
                                                    if (!string.IsNullOrEmpty(currentMinVal) && !string.IsNullOrEmpty(currentMaxVal))
                                                    {
                                                        @($"{attr.DisplayName}: {currentMinVal} - {currentMaxVal}")
                                                    }
                                                    else if (!string.IsNullOrEmpty(currentMinVal))
                                                    {
                                                        @($"{attr.DisplayName}: ≥ {currentMinVal}")
                                                    }
                                                    else
                                                    {
                                                        @($"{attr.DisplayName}: ≤ {currentMaxVal}")
                                                    }
                                                }
                                                else
                                                {
                                                    @attr.DisplayName
                                                }
                                            </span>
                                        </button>
                                        <div class="dropdown-menu p-3 bg-theme-card border-theme shadow-lg" style="min-width: 250px; font-size: 0.86rem;">
                                            <label class="form-label text-secondary-theme fw-bold mb-2">@attr.DisplayName (Min - Max)</label>
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <input type="number" step="any" name="@minKey" class="form-control form-control-sm bg-theme text-primary-theme border-theme" placeholder="Min" value="@currentMinVal" />
                                                <span class="text-secondary-theme font-mono fw-bold">-</span>
                                                <input type="number" step="any" name="@maxKey" class="form-control form-control-sm bg-theme text-primary-theme border-theme" placeholder="Max" value="@currentMaxVal" />
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-sm btn-warning fw-bold px-3">Uygula</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    var currentAttrVal = Context.Request.Query[attr.Name].ToString();
                                    var hasVal = !string.IsNullOrEmpty(currentAttrVal);

                                    <div class="dropdown">
                                        <button class="btn bg-theme border @(hasVal ? "border-warning text-warning fw-bold" : "border-theme text-primary-theme") dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.86rem;">
                                            <i class="bi bi-sliders text-warning"></i>
                                            <span>@(hasVal ? $"{attr.DisplayName}: {currentAttrVal}" : attr.DisplayName)</span>
                                        </button>
                                        <div class="dropdown-menu p-3 bg-theme-card border-theme shadow-lg" style="min-width: 220px; font-size: 0.86rem;">
                                            <label class="form-label text-secondary-theme fw-bold mb-2">@attr.DisplayName</label>
                                            
                                            @if (attr.Type == DefenceDB.EL.Models.AttributeType.Boolean)
                                            {
                                                var baseUrl = Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, sortBy = ViewBag.CurrentSortBy });
                                                <div class="d-flex flex-column gap-1">
                                                    <a class="dropdown-item rounded-2 @(string.IsNullOrEmpty(currentAttrVal) ? "active bg-warning text-dark" : "text-primary-theme")" href="@baseUrl">Tümü</a>
                                                    <a class="dropdown-item rounded-2 @(currentAttrVal == "true" ? "active bg-warning text-dark" : "text-primary-theme")" href="@(baseUrl + $"&{attr.Name}=true")">Evet</a>
                                                    <a class="dropdown-item rounded-2 @(currentAttrVal == "false" ? "active bg-warning text-dark" : "text-primary-theme")" href="@(baseUrl + $"&{attr.Name}=false")">Hayır</a>
                                                </div>
                                            }
                                            else if (attr.Type == DefenceDB.EL.Models.AttributeType.Dropdown && attr.Options != null && attr.Options.Any())
                                            {
                                                var baseUrl = Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, sortBy = ViewBag.CurrentSortBy });
                                                <div class="d-flex flex-column gap-1" style="max-height: 200px; overflow-y: auto;">
                                                    <a class="dropdown-item rounded-2 @(string.IsNullOrEmpty(currentAttrVal) ? "active bg-warning text-dark" : "text-primary-theme")" href="@baseUrl">Tümü</a>
                                                    @foreach (var opt in attr.Options)
                                                    {
                                                        <a class="dropdown-item rounded-2 @(currentAttrVal == opt ? "active bg-warning text-dark" : "text-primary-theme")" href="@(baseUrl + $"&{attr.Name}={System.Web.HttpUtility.UrlEncode(opt)}")">@opt</a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-2">
                                                    <input type="text" name="@attr.Name" class="form-control form-control-sm bg-theme text-primary-theme border-theme" placeholder="Aranacak..." value="@currentAttrVal" />
                                                    <button type="submit" class="btn btn-sm btn-warning">Ara</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }

                    </form>

                    <!-- Active Filters Bar (Herhangi bir filtre aktifse görünür) -->
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentCountry) || !string.IsNullOrEmpty(ViewBag.CurrentStatus) || !string.IsNullOrEmpty(ViewBag.CurrentSearch) || isAnyFilterActive)
                    {
                        <div class="d-flex align-items-center flex-wrap gap-2 pt-2 mt-2 border-top border-theme">
                            <span class="fs-8 text-secondary-theme fw-semibold me-1"><i class="bi bi-funnel-fill text-warning me-1"></i>Aktif Filtreler:</span>
                            
                            @if (!string.IsNullOrEmpty(ViewBag.CurrentCountry))
                            {
                                <a href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, sortBy = ViewBag.CurrentSortBy })" class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1 text-decoration-none d-inline-flex align-items-center gap-1 fs-8">
                                    <span>Ülke: @ViewBag.CurrentCountry</span>
                                    <i class="bi bi-x-lg ms-1" style="font-size: 0.65rem;"></i>
                                </a>
                            }

                            @if (!string.IsNullOrEmpty(ViewBag.CurrentStatus))
                            {
                                <a href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, sortBy = ViewBag.CurrentSortBy })" class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1 text-decoration-none d-inline-flex align-items-center gap-1 fs-8">
                                    <span>Durum: @ViewBag.CurrentStatus</span>
                                    <i class="bi bi-x-lg ms-1" style="font-size: 0.65rem;"></i>
                                </a>
                            }

                            @if (filterAttrs != null)
                            {
                                foreach (var attr in filterAttrs)
                                {
                                    if (attr.Type == DefenceDB.EL.Models.AttributeType.Number)
                                    {
                                        var minVal = Context.Request.Query[attr.Name + "_min"].ToString();
                                        var maxVal = Context.Request.Query[attr.Name + "_max"].ToString();
                                        if (!string.IsNullOrEmpty(minVal) || !string.IsNullOrEmpty(maxVal))
                                        {
                                            var labelText = !string.IsNullOrEmpty(minVal) && !string.IsNullOrEmpty(maxVal) 
                                                ? $"{attr.DisplayName}: {minVal} - {maxVal}" 
                                                : (!string.IsNullOrEmpty(minVal) ? $"{attr.DisplayName}: ≥ {minVal}" : $"{attr.DisplayName}: ≤ {maxVal}");
                                            
                                            <a href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, sortBy = ViewBag.CurrentSortBy })" class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1 text-decoration-none d-inline-flex align-items-center gap-1 fs-8">
                                                <span>@labelText</span>
                                                <i class="bi bi-x-lg ms-1" style="font-size: 0.65rem;"></i>
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        var val = Context.Request.Query[attr.Name].ToString();
                                        if (!string.IsNullOrEmpty(val))
                                        {
                                            var displayVal = val switch { "true" => "Evet", "false" => "Hayır", _ => val };
                                            <a href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus, sortBy = ViewBag.CurrentSortBy })" class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1 text-decoration-none d-inline-flex align-items-center gap-1 fs-8">
                                                <span>@attr.DisplayName: @displayVal</span>
                                                <i class="bi bi-x-lg ms-1" style="font-size: 0.65rem;"></i>
                                            </a>
                                        }
                                    }
                                }
                            }

                            <!-- Filtreleri Temizle Butonu (Aktif Filtreler Çubuğunun Sağında) -->
                            @if (isAnyFilterActive)
                            {
                                <a href="@Url.Action("Index", "Product", new { categorySlug = currentCategory?.Slug, country = ViewBag.CurrentCountry })" 
                                   class="btn btn-sm btn-outline-danger rounded-pill px-3 ms-auto d-inline-flex align-items-center gap-1.5 shadow-2xs font-outfit" style="font-size: 0.82rem;" title="Ülke filtresi hariç tüm filtreleri sıfırlar">
                                    <i class="bi bi-x-circle-fill"></i>
                                    <span>Filtreleri Temizle</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Products List / Grid -->
            @if (Model.Count == 0)
            {
                <div class="bg-theme-card border border-theme rounded-4 p-5 text-center my-4 shadow-sm">
                    <i class="bi bi-shield-slash text-warning fs-1"></i>
                    <h4 class="mt-3 text-primary-theme">Kayıt Bulunamadı</h4>
                    <p class="text-secondary-theme">Seçilen kriterlere uygun henüz ürün verisi bulunmamaktadır.</p>
                    <a href="/Product" class="btn btn-warning text-dark btn-sm rounded-pill px-4 mt-2">Tüm Ürünlere Dön</a>
                </div>
            }
            else
            {
                <!-- Product List (Ürün Listesi) -->
                <div id="productListView" class="product-list-view d-flex flex-column gap-3">
                    @foreach (var prod in Model)
                    {
                        var mainImage = prod.Images?.FirstOrDefault(i => i.IsMainImage)?.ImagePath ?? prod.Images?.FirstOrDefault()?.ImagePath ?? "/images/default.jpg";
                        var thumbImage = toThumb(mainImage);
                        
                        <div class="product-list-item bg-theme-card border border-theme rounded-4 p-2.5 p-md-3 shadow-sm d-flex flex-column flex-md-row gap-2 gap-md-3 align-items-stretch" 
                             style="cursor: pointer; transition: all 0.2s ease;" 
                             onclick="handleProductClick(event, '/Product/Detail/@(prod.Id)-@(prod.Slug)')">
                             
                            <!-- SOL: Ürün Görseli (Masaüstü Kolonu) -->
                            <div class="product-list-img-wrapper d-none d-md-block" style="width: 130px; flex-shrink: 0; min-height: 100px;">
                                <img src="@thumbImage" alt="@prod.Name" loading="lazy" decoding="async" 
                                     style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px; border: 1px solid var(--border-theme);" 
                                     onerror="this.onerror=null; this.src='@mainImage';" />
                            </div>

                            <!-- MOBİL ÜST SATIR (Yalnızca Mobilde: Sol Resim, Sağ İsim & Bayrak/Üretici) -->
                            <div class="d-flex d-md-none align-items-stretch gap-2.5 w-100">
                                <div class="product-list-img-wrapper-mobile" style="width: 110px; height: 85px; flex-shrink: 0;">
                                    <img src="@thumbImage" alt="@prod.Name" loading="lazy" decoding="async" 
                                         style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px; border: 1px solid var(--border-theme);" 
                                         onerror="this.onerror=null; this.src='@mainImage';" />
                                </div>
                                <div class="bg-theme rounded-3 p-2 px-2.5 flex-grow-1 d-flex flex-column justify-content-between overflow-hidden" style="min-height: 85px;">
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <h5 class="text-primary-theme fw-bold mb-0" style="font-size: 1rem;">@prod.Name</h5>
                                        @if (!string.IsNullOrEmpty(prod.NatoReportingName))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill" style="font-size: 0.68rem;">NATO: "@prod.NatoReportingName"</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between gap-2 mt-1">
                                        <span class="fs-8 text-muted-theme text-truncate" style="max-width: 130px;" title="@(prod.Manufacturer ?? "")">
                                            @(string.IsNullOrWhiteSpace(prod.Manufacturer) ? "\u00A0" : prod.Manufacturer)
                                        </span>
                                        @if (!string.IsNullOrEmpty(prod.Country) && !string.IsNullOrEmpty(CountryHelper.GetFlagUrl(prod.Country)))
                                        {
                                            <img src="@CountryHelper.GetFlagUrl(prod.Country)" alt="@prod.Country" title="@prod.Country" style="width: 24px; height: 15px; object-fit: cover; border-radius: 3px; border: 1px solid var(--border-theme); flex-shrink: 0;" />
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- SAĞ İÇERİK ALANI (Masaüstünde Resim Yanı, Mobilde Alt Kısım) -->
                            <div class="d-flex flex-column gap-2 flex-grow-1" style="min-width: 0;">
                                
                                <!-- 1. ÜST KUTU: Ürün Adı (Sol), Bayrak & Üretici (Sağ) - Yalnızca Masaüstünde Görünür -->
                                <div class="bg-theme rounded-3 p-2.5 px-3 d-none d-md-flex align-items-center justify-content-between gap-2 flex-wrap" style="min-height: 52px;">
                                    <!-- Sol: Ürün Adı ve NATO -->
                                    <div class="d-flex align-items-center gap-2">
                                        <h5 class="text-primary-theme fw-bold mb-0" style="font-size: 1.1rem;">@prod.Name</h5>
                                        @if (!string.IsNullOrEmpty(prod.NatoReportingName))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill" style="font-size: 0.72rem;">NATO: "@prod.NatoReportingName"</span>
                                        }
                                    </div>

                                    <!-- Sağ: Üstte Şık Bayrak, Altta Üretici Bilgisi (Üretici yoksa bile yüksekliği sabit kalır) -->
                                    <div class="text-end d-flex flex-column align-items-end justify-content-center" style="min-width: 90px; min-height: 38px;">
                                        @if (!string.IsNullOrEmpty(prod.Country) && !string.IsNullOrEmpty(CountryHelper.GetFlagUrl(prod.Country)))
                                        {
                                            <div class="mb-1" title="@prod.Country">
                                                <img src="@CountryHelper.GetFlagUrl(prod.Country)" alt="@prod.Country" style="width: 28px; height: 18px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-theme);" />
                                            </div>
                                        }
                                        <span class="fs-8 text-muted-theme text-truncate" style="max-width: 180px;" title="@(prod.Manufacturer ?? "")">
                                            @(string.IsNullOrWhiteSpace(prod.Manufacturer) ? "\u00A0" : prod.Manufacturer)
                                        </span>
                                    </div>
                                </div>

                                <!-- 2. ALT KUTU: Kategoriye Özel Özellikler (Sığmadığında 2. Satıra Kayabilen Esnek Yapı) -->
                                <div class="bg-theme rounded-3 p-2.5 px-3 flex-grow-1 d-flex align-items-center" style="min-height: 44px;">
                                    @{
                                        var validSpecs = prod.Specs?
                                            .Where(s => !string.IsNullOrWhiteSpace(s.Value) 
                                                     && s.Value != "true,false")
                                            .Take(7)
                                            .ToList();

                                        // Soft Pastel Renk Paleti (Sırasıyla döner)
                                        var pastelColorStyles = new[] {
                                            "background-color: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); color: #2563eb;",  // Soft Blue
                                            "background-color: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.28); color: #d97706;", // Soft Amber
                                            "background-color: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #059669;", // Soft Emerald
                                            "background-color: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.25); color: #7c3aed;", // Soft Purple
                                            "background-color: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.28); color: #0284c7;", // Soft Cyan
                                            "background-color: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); color: #e11d48;"    // Soft Rose
                                        };
                                    }
                                    @if (validSpecs != null && validSpecs.Any())
                                    {
                                        <div class="d-flex align-items-center gap-2 flex-wrap w-100" style="font-size: 0.8rem;">
                                            @for (int i = 0; i < validSpecs.Count; i++)
                                            {
                                                var spec = validSpecs[i];
                                                var label = GetSpecLabel(spec.Key);
                                                var badgeStyle = pastelColorStyles[i % pastelColorStyles.Length];
                                                var displayVal = spec.Value switch {
                                                    "true" or "True" => "Evet",
                                                    "false" or "False" => "Hayır",
                                                    _ => spec.Value
                                                };

                                                <div class="px-3 py-1.5 rounded-2 d-inline-flex align-items-center gap-2 text-nowrap font-outfit shadow-2xs" 
                                                     style="@badgeStyle font-size: 0.8rem; border-radius: 6px;">
                                                    <span class="opacity-75 font-outfit fw-medium">@label:</span>
                                                    <strong class="fw-bold font-outfit" style="color: inherit;">@displayVal</strong>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fs-8 text-muted-theme italic opacity-50">Kategoriye özel ek detay belirtilmedi.</span>
                                    }
                                </div>

                            </div>

                        </div>
                    }
                </div>
            }

            @if (ViewBag.TotalPages > 1)
            {
                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
                var currentCategorySlug = ViewBag.CurrentCategory?.Slug;
                var currentCountry = ViewBag.CurrentCountry;
                var currentSearch = ViewBag.CurrentSearch;
                var currentStatus = ViewBag.CurrentStatus;
                var currentSortBy = ViewBag.CurrentSortBy;
                var currentViewMode = ViewBag.CurrentViewMode;

                <div class="admin-pagination-wrapper mt-5">
                    <ul class="admin-pagination">
                        <li class="@(currentPage == 1 ? "disabled" : "")">
                            <a href="@(currentPage > 1 ? Url.Action("Index", new { categorySlug = currentCategorySlug, country = currentCountry, search = currentSearch, status = currentStatus, sortBy = currentSortBy, viewMode = currentViewMode, page = currentPage - 1 }) : "#")" class="page-link-custom page-link-text">
                                <i class="bi bi-chevron-left me-1" style="font-size: 0.8rem;"></i> Önceki
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                            {
                                <li class="@(i == currentPage ? "active" : "")">
                                    <a href="@Url.Action("Index", new { categorySlug = currentCategorySlug, country = currentCountry, search = currentSearch, status = currentStatus, sortBy = currentSortBy, viewMode = currentViewMode, page = i })" class="page-link-custom">@i</a>
                                </li>
                            }
                            else if (i == 2 && currentPage > 3)
                            {
                                <li><span class="ellipsis">...</span></li>
                            }
                            else if (i == totalPages - 1 && currentPage < totalPages - 2)
                            {
                                <li><span class="ellipsis">...</span></li>
                            }
                        }

                        <li class="@(currentPage == totalPages ? "disabled" : "")">
                            <a href="@(currentPage < totalPages ? Url.Action("Index", new { categorySlug = currentCategorySlug, country = currentCountry, search = currentSearch, status = currentStatus, sortBy = currentSortBy, viewMode = currentViewMode, page = currentPage + 1 }) : "#")" class="page-link-custom page-link-text">
                                Sonraki <i class="bi bi-chevron-right ms-1" style="font-size: 0.8rem;"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }

        </div>
    </div>
</div>

<style>
    @@keyframes categoryHeartbeat {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.6); }
        50% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    .btn-category-pulse {
        animation: categoryHeartbeat 2.2s infinite ease-in-out;
        transition: all 0.2s ease;
    }
    .btn-category-pulse:hover {
        animation: none;
        transform: scale(1.06);
    }
</style>


