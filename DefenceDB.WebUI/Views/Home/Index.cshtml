@{
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var recentProducts = ViewBag.RecentProducts as List<DefenseProduct> ?? new List<DefenseProduct>();
    var showcaseArticles = ViewBag.ShowcaseArticles as List<Article> ?? new List<Article>();
    ViewData["IsHome"] = true;
    // Thumbnail helper: /images/products/x.webp -> /images/thumbs/x.webp
    Func<string, string> toThumb = path => {
        if (string.IsNullOrEmpty(path)) return "/images/default.jpg";
        var fileName = System.IO.Path.GetFileName(path);
        return $"/images/thumbs/{fileName}";
    };
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<!-- Hero Section with Full Screen Video -->
<section class="hero-video-wrapper">
    <!-- Masaüstü Videosu (Geniş Ekranlar - Yatay 16:9) -->
    <video loop muted playsinline preload="auto" class="home-hero-video d-none d-md-block">
        <source data-src="/videos/home.mp4" type="video/mp4">
        <source data-src="https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4">
    </video>
    
    <!-- Mobil Videosu (Telefonlar - Dikey 9:16) -->
    <video loop muted playsinline preload="auto" class="home-hero-video d-block d-md-none">
        <source data-src="/videos/home.mp4" type="video/mp4">
        <!-- Kaliteli ve akıcı dikey uçak uçuşu fallback videosu -->
        <source data-src="https://assets.mixkit.co/videos/preview/mixkit-fighter-jet-maneuvering-in-the-clouds-43187-large.mp4" type="video/mp4">
    </video>
    
    <div class="hero-overlay"></div>
    
    <div class="container hero-content h-100 d-flex flex-column justify-content-end pb-5">
        <div class="quote-wrapper text-center w-100 mb-4 px-3" style="animation: fadeInUp 1.5s ease-out;">
            <p class="text-white opacity-90 fst-italic mx-auto" style="max-width: 800px; font-size: 1.45rem; line-height: 1.6; font-family: 'Outfit', sans-serif;">
                "Uçmayı bir kere tattıktan sonra, yeryüzünde sonsuza dek gözleriniz gökyüzüne çevrilmiş bir şekilde yürüyeceksiniz..."
            </p>
            <p class="fw-bold mt-2" style="font-size: 0.95rem; letter-spacing: 2.5px; color: #cbd5e1;">
                — LEONARDO DA VINCI
            </p>
        </div>
    </div>
</section>

<script>
    (function () {
        function loadHomeHeroVideo() {
            var isMobile = window.matchMedia('(max-width: 767.98px)').matches;
            var selector = isMobile ? '.home-hero-video.d-md-none' : '.home-hero-video.d-md-block';
            var video = document.querySelector(selector);

            if (!video || video.dataset.loaded === 'true') return;

            video.querySelectorAll('source[data-src]').forEach(function (source) {
                source.src = source.dataset.src;
            });

            video.dataset.loaded = 'true';
            video.load();

            var playPromise = video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
                playPromise.catch(function () { });
            }
        }

        // Delay loading just a little bit so it doesn't block the very first frame render
        window.addEventListener('DOMContentLoaded', function () {
            setTimeout(loadHomeHeroVideo, 100);
        });
    })();
</script>

<!-- Showcase Products Section (Vitrin) -->
@{
    var showcaseProducts = ViewBag.ShowcaseProducts as List<DefenseProduct> ?? new List<DefenseProduct>();
}

@if (showcaseProducts.Any())
{
    <section class="container home-section">
        <div class="home-section-header">
            <div>
                <h2 class="home-section-title">Sizin İçin Seçtiklerimiz</h2>
                <p class="home-section-subtitle">Geleceğin Türk Hava Kuvvetleri ve öne çıkan stratejik sistemler</p>
            </div>
        </div>

        <div class="row g-3 g-md-4">
            @{ var showIndex = 0; }
            @foreach (var prod in showcaseProducts)
            {
                var mainImage = prod.Images?.FirstOrDefault(i => i.IsMainImage)?.ImagePath ?? prod.Images?.FirstOrDefault()?.ImagePath ?? "/images/default.jpg";
                var thumbImage = toThumb(mainImage);
                var categoryName = prod.Category?.Name;
                <div class="col-6 col-md-6 col-lg-3 reveal-card" style="--delay: @(showIndex * 45)ms;">
                    <div class="card-premium home-product-card h-100 d-flex flex-column" onclick="handleProductClick(event, '/@(prod.Slug)')">
                        @if (!string.IsNullOrWhiteSpace(categoryName))
                        {
                            <span class="home-card-badge">@categoryName</span>
                        }
                        <div class="card-img-wrapper">
                            <img src="@thumbImage" alt="@prod.Name" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='@mainImage';" />
                        </div>
                        <div class="card-body d-flex flex-column flex-grow-1">
                            <h5 class="home-card-title text-truncate" title="@prod.Name">@prod.Name</h5>
                            
                            @if (!string.IsNullOrEmpty(prod.NatoReportingName))
                            {
                                <div class="home-card-nato">NATO: "@prod.NatoReportingName"</div>
                            }

                            <div class="flex-grow-1"></div>
                            
                            <div class="home-card-meta">
                                <span class="home-card-country-name text-truncate">@(!string.IsNullOrEmpty(prod.Country) ? prod.Country : "Bilinmiyor")</span>
                                @if (!string.IsNullOrEmpty(prod.Country) && !string.IsNullOrEmpty(CountryHelper.GetFlagUrl(prod.Country)))
                                {
                                    <img src="@CountryHelper.GetFlagUrl(prod.Country)" alt="@prod.Country" title="@prod.Country" class="home-card-flag" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
                showIndex++;
            }
        </div>
    </section>
}

@if (showcaseArticles.Any())
{
    <section class="container home-section">
        <div class="home-section-header">
            <div>
                <h2 class="home-section-title">Öne Çıkan Makaleler</h2>
                <p class="home-section-subtitle">Editörün seçtiği analizler ve savunma sanayii derlemeleri</p>
            </div>
            <a asp-controller="Articles" asp-action="Index" class="home-section-link">
                <span>Tüm Makaleleri Gör</span> <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="grid-5-columns">
            @{ var articleIndex = 0; }
            @foreach (var article in showcaseArticles)
            {
                <div class="reveal-card" style="--delay: @(articleIndex * 35)ms;">
                    <article class="home-article-card h-100" onclick="location.href='@Url.Action("Detail", "Articles", new { slug = article.Slug })'">
                        <span class="home-article-category">@article.ArticleCategory?.Name</span>
                        <h3 title="@article.Title">@article.Title</h3>
                        <div class="home-article-footer">
                            <time datetime="@((article.PublishedAt ?? article.CreatedAt).ToString("yyyy-MM-dd"))">@((article.PublishedAt ?? article.CreatedAt).ToString("dd.MM.yyyy"))</time>
                            <span class="home-article-read">Oku <i class="bi bi-arrow-up-right"></i></span>
                        </div>
                    </article>
                </div>
                articleIndex++;
            }
        </div>
    </section>
}

<!-- Categories Section -->
<section class="container home-section">
    <div class="home-section-header">
        <div>
            <h2 class="home-section-title">Savunma Kategorileri</h2>
            <p class="home-section-subtitle">Teknoloji sınıflarına göre filtreleyip detaylı teknik incelemeler yapabilirsiniz</p>
        </div>
        <a href="/ara" class="home-section-link">
            <span>Tüm Kategorileri Gör</span> <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-3 g-md-4">
        @{ var catIndex = 0; }
        @foreach (var cat in categories)
        {
            <div class="col-6 col-md-4 reveal-card" style="--delay: @(catIndex * 45)ms;">
                <div class="home-category-card d-flex flex-column h-100" onclick="location.href='@Url.Action("Index", "Product", new { categorySlug = cat.Slug })'">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="home-category-icon">
                            <i class="@cat.IconClass"></i>
                        </div>
                        <h4 class="home-category-title mb-0">@cat.Name</h4>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(cat.Description))
                    {
                        <p class="home-category-desc mb-3 flex-grow-1">@cat.Description</p>
                    }
                    else
                    {
                        <div class="flex-grow-1"></div>
                    }
                    <div class="home-category-footer">
                        <span>Envanteri İncele</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </div>
            catIndex++;
        }
    </div>
</section>

<!-- Recent Products Section (5 per row, 2 rows) -->
<section class="container home-section pb-4">
    <div class="home-section-header">
        <div>
            <h2 class="home-section-title">En Son Eklenen Ürünler</h2>
            <p class="home-section-subtitle">Veritabanına en son eklenen savunma sanayii platformları ve mühimmatlar</p>
        </div>
        <a href="/ara" class="home-section-link">
            <span>Tüm Veritabanını Gör</span> <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="grid-5-columns">
        @{ var prodIndex = 0; }
        @foreach (var prod in recentProducts)
        {
            var mainImage = prod.Images?.FirstOrDefault(i => i.IsMainImage)?.ImagePath ?? prod.Images?.FirstOrDefault()?.ImagePath ?? "/images/default.jpg";
            var thumbImage = toThumb(mainImage);
            var categoryName = prod.Category?.Name;
            <div class="reveal-card" style="--delay: @(prodIndex * 35)ms;">
                <div class="card-premium home-product-card card-compact h-100 d-flex flex-column" onclick="handleProductClick(event, '/@(prod.Slug)')">
                    @if (!string.IsNullOrWhiteSpace(categoryName))
                    {
                        <span class="home-card-badge home-card-badge-sm">@categoryName</span>
                    }
                    <div class="card-img-wrapper">
                        <img src="@thumbImage" alt="@prod.Name" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='@mainImage';" />
                    </div>
                    <div class="card-body p-0 d-flex flex-column flex-grow-1">
                        <h5 class="home-card-title home-card-title-sm text-truncate m-0" title="@prod.Name">@prod.Name</h5>
                        
                        @if (!string.IsNullOrEmpty(prod.NatoReportingName))
                        {
                            <div class="home-card-nato mt-1">NATO: "@prod.NatoReportingName"</div>
                        }

                        <div class="flex-grow-1"></div>
                        
                        <div class="home-card-meta home-card-meta-sm">
                            <span class="home-card-country-name text-truncate">@(!string.IsNullOrEmpty(prod.Country) ? prod.Country : prod.CreatedAt.ToString("dd.MM.yyyy"))</span>
                            @if (!string.IsNullOrEmpty(prod.Country) && !string.IsNullOrEmpty(CountryHelper.GetFlagUrl(prod.Country)))
                            {
                                <img src="@CountryHelper.GetFlagUrl(prod.Country)" alt="@prod.Country" title="@prod.Country" class="home-card-flag home-card-flag-sm" />
                            }
                        </div>
                    </div>
                </div>
            </div>
            prodIndex++;
        }
    </div>
</section>

