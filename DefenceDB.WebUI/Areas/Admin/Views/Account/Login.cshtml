@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - DefenceDB Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo text-center mb-4">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-2" style="font-family: 'Outfit', sans-serif;">
                    <i class="bi bi-shield-fill" style="font-size: 2.5rem; color: #ffc107; filter: drop-shadow(0 0 12px rgba(255, 193, 7, 0.4));"></i>
                    <span style="font-size: 2.2rem; font-weight: 700; color: #fff; letter-spacing: -0.02em;">
                        DEFENCE<strong style="color: #ffc107;">DB</strong>
                    </span>
                </div>
                <p style="color: #94a3b8; font-size: 0.95rem; margin: 0;">Yönetim paneline erişmek için giriş yapın</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="login-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="form-group">
                    <label for="email">
                        <i class="bi bi-envelope-fill me-1"></i> E-posta Adresi
                    </label>
                    <input type="email" id="email" name="email" placeholder="admin@example.com" required autocomplete="email" autofocus />
                </div>

                <div class="form-group">
                    <label for="password">
                        <i class="bi bi-lock-fill me-1"></i> Şifre
                    </label>
                    <div style="position: relative;">
                        <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password" style="width: 100%; padding-right: 40px;" />
                        <i class="bi bi-eye-slash" id="togglePassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #6c757d; font-size: 1.1rem;"></i>
                    </div>
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Giriş Yap
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none" style="color: var(--admin-text-muted); font-size: 0.8rem;">
                    <i class="bi bi-arrow-left me-1"></i> Ana Siteye Dön
                </a>
            </div>
        </div>
    </div>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#password');

        togglePassword.addEventListener('click', function (e) {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.classList.toggle('bi-eye');
            this.classList.toggle('bi-eye-slash');
        });
    </script>
</body>
</html>
