@model DefenceDB.WebUI.Services.MigrationResult?
@{
    ViewData["Title"] = "Backblaze Medya Göçü";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-family: 'Outfit', sans-serif; font-weight: 700; margin: 0;">
            <i class="bi bi-cloud-arrow-up-fill text-warning me-2"></i> Backblaze Medya Göçü
        </h4>
        <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin: 4px 0 0;">
            wwwroot içerisindeki tüm ürün resimlerini (images) ve videoları (videos) canlı % ilerleme çubuğuyla Backblaze B2 bulut depolamaya otomatik aktarın.
        </p>
    </div>
</div>

<div class="row g-4">
    <!-- Backblaze Kimlik Bilgileri Formu -->
    <div class="col-lg-6">
        <div class="admin-card p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-key-fill text-warning"></i> Backblaze B2 API Bilgileri
            </h5>
            <form id="migrationForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label font-outfit fw-semibold">Key ID (kopyalanan keyID)</label>
                    <input type="text" id="inputKeyId" value="@ViewBag.KeyId" class="admin-input form-control" placeholder="Örn: 7ab639773f83" required />
                </div>

                <div class="mb-3">
                    <label class="form-label font-outfit fw-semibold">Application Key (gizli anahtar)</label>
                    <input type="password" id="inputAppKey" value="@ViewBag.ApplicationKey" class="admin-input form-control" placeholder="Örn: K004..." required />
                </div>

                <div class="mb-3">
                    <label class="form-label font-outfit fw-semibold">Bucket Name (Bucket Adı)</label>
                    <input type="text" id="inputBucket" value="@ViewBag.BucketName" class="admin-input form-control" placeholder="Örn: defencedb" required />
                </div>

                <div class="mb-4">
                    <label class="form-label font-outfit fw-semibold">Service URL / Endpoint</label>
                    <input type="text" id="inputUrl" value="@ViewBag.ServiceUrl" class="admin-input form-control" placeholder="https://s3.us-west-004.backblazeb2.com" required />
                    <span class="fs-8 text-muted d-block mt-1">Örnek: <code>https://s3.us-west-004.backblazeb2.com</code></span>
                </div>

                <button type="button" id="btnStartMigration" onclick="startLiveMigration()" class="btn-admin-warning w-100 justify-content-center py-2 text-dark font-outfit fw-bold">
                    <i class="bi bi-cloud-upload-fill me-2"></i> Canlı Medya Aktarımını Başlat (AJAX % İlerleme)
                </button>
            </form>
        </div>
    </div>

    <!-- Canlı İlerleme & İstatistik Kartı -->
    <div class="col-lg-6">
        <!-- İlerleme Çubuğu Paneli (Aktarım Başlayınca Görünür) -->
        <div id="progressCard" class="admin-card p-4 mb-4 d-none border border-warning border-opacity-50">
            <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
                <span><i class="bi bi-arrow-repeat text-warning me-2 spinner-border spinner-border-sm"></i> Aktarım Yapılıyor...</span>
                <span id="txtPercentage" class="badge bg-warning text-dark font-outfit fs-6">0%</span>
            </h5>
            
            <div class="progress bg-dark mb-3" style="height: 22px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-theme);">
                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-warning text-dark fw-bold" role="progressbar" style="width: 0%; transition: width 0.3s ease;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
            </div>

            <div class="row text-center g-2 mb-2">
                <div class="col-3">
                    <div class="p-2 border border-theme rounded-3 bg-theme">
                        <span class="d-block fs-8 text-muted">İşlenen</span>
                        <strong id="statProcessed" class="fs-7 text-primary-theme">0 / 0</strong>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-2 border border-success border-opacity-25 rounded-3 bg-success bg-opacity-10 text-success">
                        <span class="d-block fs-8">Başarılı</span>
                        <strong id="statSuccess" class="fs-7">0</strong>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-2 border border-danger border-opacity-25 rounded-3 bg-danger bg-opacity-10 text-danger">
                        <span class="d-block fs-8">Hata</span>
                        <strong id="statFailed" class="fs-7">0</strong>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-2 border border-info border-opacity-25 rounded-3 bg-info bg-opacity-10 text-info">
                        <span class="d-block fs-8">Boyut</span>
                        <strong id="statSize" class="fs-7">0 MB</strong>
                    </div>
                </div>
            </div>
            
            <div id="txtCurrentFile" class="fs-8 text-muted text-truncate mt-1">
                İşleniyor: <span class="text-primary-theme font-monospace">Hazırlanıyor...</span>
            </div>
        </div>

        <!-- Rehber Kartı -->
        <div class="admin-card p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-warning"></i> Canlı Aktarım Özellikleri
            </h5>
            <ul class="text-secondary fs-7 mb-0 d-flex flex-column gap-2 ps-3">
                <li>Backblaze <strong>keyID</strong> ve <strong>applicationKey</strong> bilgilerinizi girin.</li>
                <li><strong>"Canlı Medya Aktarımını Başlat"</strong> butonuna bastığınızda tarayıcınız kilitlenmeden, canlı yüzdelik ilerleme çubuğuyla tüm görseller sırayla yüklenir.</li>
                <li>Sayfa yenilenmez; <strong>%0'dan %100'e kadar anlık progress</strong> ekranda görüntülenir.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Canlı Log Tablosu -->
<div id="logsWrapper" class="mt-4 d-none">
    <h5 class="fw-bold mb-3 font-outfit d-flex align-items-center gap-2">
        <i class="bi bi-terminal-fill text-warning"></i> Canlı Yükleme Log Akışı
    </h5>
    <div class="table-wrapper">
        <div id="logScrollContainer" class="table-body" style="max-height: 350px; overflow-y: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Dosya Yolu</th>
                        <th>Boyut</th>
                        <th>Durum</th>
                        <th>Mesaj</th>
                    </tr>
                </thead>
                <tbody id="logTbody">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let isRunning = false;

        async function startLiveMigration() {
            if (isRunning) return;

            const keyId = document.getElementById('inputKeyId').value.trim();
            const appKey = document.getElementById('inputAppKey').value.trim();
            const bucket = document.getElementById('inputBucket').value.trim();
            const url = document.getElementById('inputUrl').value.trim();

            if (!keyId || !appKey || !bucket) {
                alert('Lütfen Key ID, Application Key ve Bucket İsmi alanlarını doldurun!');
                return;
            }

            isRunning = true;
            const btn = document.getElementById('btnStartMigration');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Aktarım Devam Ediyor...';

            const progressCard = document.getElementById('progressCard');
            const logsWrapper = document.getElementById('logsWrapper');
            const tbody = document.getElementById('logTbody');
            const progressBar = document.getElementById('progressBar');
            const txtPercentage = document.getElementById('txtPercentage');

            progressCard.classList.remove('d-none');
            logsWrapper.classList.remove('d-none');
            tbody.innerHTML = '';

            // 1. Step: Get list of local files
            let fileList = [];
            try {
                const response = await fetch('/Admin/StorageManagement/GetFileList', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (data && data.success && data.files) {
                    fileList = data.files;
                }
            } catch (ex) {
                alert('Dosya listesi alınırken hata oluştu: ' + ex.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-2"></i> Canlı Medya Aktarımını Başlat (AJAX % İlerleme)';
                isRunning = false;
                return;
            }

            const total = fileList.length;
            if (total === 0) {
                alert('wwwroot/images veya wwwroot/videos klasöründe yüklenecek dosya bulunamadı!');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-2"></i> Canlı Medya Aktarımını Başlat (AJAX % İlerleme)';
                isRunning = false;
                return;
            }

            let successCount = 0;
            let failedCount = 0;
            let totalBytes = 0;

            // 2. Step: Loop over files and upload sequentially
            for (let i = 0; i < total; i++) {
                const filePath = fileList[i];
                document.getElementById('txtCurrentFile').innerHTML = `İşleniyor (${i+1}/${total}): <span class="text-warning font-monospace">${filePath}</span>`;

                try {
                    const uploadRes = await fetch('/Admin/StorageManagement/UploadSingleFile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            relativePath: filePath,
                            keyId: keyId,
                            applicationKey: appKey,
                            bucketName: bucket,
                            serviceUrl: url
                        })
                    });

                    const logItem = await uploadRes.json();

                    if (logItem.isSuccess) {
                        successCount++;
                        totalBytes += logItem.fileSizeBytes || 0;
                    } else {
                        failedCount++;
                    }

                    // Append row to table
                    const row = document.createElement('tr');
                    const sizeKb = ((logItem.fileSizeBytes || 0) / 1024.0).toFixed(1);
                    const statusBadge = logItem.isSuccess 
                        ? '<span class="badge bg-success">Başarılı</span>' 
                        : '<span class="badge bg-danger">Hata</span>';

                    row.innerHTML = `
                        <td>${i + 1}</td>
                        <td><code>${logItem.relativePath}</code></td>
                        <td>${sizeKb} KB</td>
                        <td>${statusBadge}</td>
                        <td>${logItem.message}</td>
                    `;
                    tbody.appendChild(row);

                    // Auto scroll log container
                    const container = document.getElementById('logScrollContainer');
                    container.scrollTop = container.scrollHeight;

                } catch (err) {
                    failedCount++;
                }

                // 50ms throttle to prevent API rate-limits
                await new Promise(resolve => setTimeout(resolve, 50));

                // Update Progress UI
                const percent = Math.round(((i + 1) / total) * 100);
                progressBar.style.width = percent + '%';
                progressBar.innerText = percent + '%';
                txtPercentage.innerText = percent + '%';

                document.getElementById('statProcessed').innerText = `${i + 1} / ${total}`;
                document.getElementById('statSuccess').innerText = successCount;
                document.getElementById('statFailed').innerText = failedCount;
                document.getElementById('statSize').innerText = (totalBytes / (1024 * 1024)).toFixed(2) + ' MB';
            }

            // Complete
            progressBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
            progressBar.classList.add('bg-success');
            document.getElementById('txtCurrentFile').innerHTML = `<strong class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Aktarım Başarıyla Tamamlandı! (${total} dosya işlendi)</strong>`;

            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> Aktarım Tamamlandı (Tekrar Başlat)';
            isRunning = false;
        }
    </script>
}
