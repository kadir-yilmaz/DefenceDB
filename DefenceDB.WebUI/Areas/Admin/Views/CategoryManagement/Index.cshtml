@model IEnumerable<DefenceDB.EL.Models.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-family: 'Outfit', sans-serif; font-weight: 700; margin: 0;">
            <i class="bi bi-list-nested text-warning me-2"></i> Kategori Yönetimi
        </h4>
        <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin: 4px 0 0;">
            "Navbar'da Göster" ile üst barda öne çıkan kategorileri belirleyin. Tüm kategorilere "Kategoriler" menüsünden ulaşılabilir.
        </p>
    </div>
    <span class="admin-badge info">@Model.Count() Ana Kategori</span>
</div>

<div class="table-wrapper">
    <div class="table-body">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 30%;">Kategori Adı</th>
                        <th style="width: 10%;">İkon</th>
                        <th style="width: 15%;">Alt Kategori</th>
                        <th style="width: 15%;">Navbar'da Göster</th>
                        <th style="width: 15%;">Slug</th>
                        <th style="width: 10%;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model.OrderBy(c => c.Name))
                    {
                        <tr>
                            <td>@cat.Id</td>
                            <td>
                                <div style="font-weight: 600;">@cat.Name</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(cat.IconClass))
                                {
                                    <i class="@cat.IconClass text-primary fs-5"></i>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="admin-badge info">@cat.SubCategories.Count</span>
                            </td>
                            <td>
                                @if (cat.IsShowcase)
                                {
                                    <span class="badge bg-success">Gösteriliyor</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Gizli</span>
                                }
                            </td>
                            <td>
                                <code style="font-size: 0.8rem; color: var(--admin-text-muted);">@cat.Slug</code>
                            </td>
                            <td>
                                <form asp-action="ToggleShowcase" asp-route-id="@cat.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (cat.IsShowcase)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Navbar'dan kaldır">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Navbar'da göster">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Kayıtlı kategori bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
