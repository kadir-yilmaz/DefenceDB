@using DefenceDB.EL.Models
@using DefenceDB.WebUI.Areas.Admin.Models
@model CategoryFormViewModel

@{
    ViewData["Title"] = "Kategori Düzenle";
    var allCategories = ViewBag.AllCategories as List<Category> ?? new List<Category>();

    var flattenedCategories = new System.Collections.Generic.List<(Category Category, int Level)>();
    void Flatten(IEnumerable<Category> cats, int level)
    {
        foreach (var c in cats.OrderBy(x => x.Name))
        {
            flattenedCategories.Add((c, level));
            if (c.SubCategories != null && c.SubCategories.Any())
            {
                Flatten(c.SubCategories, level + 1);
            }
        }
    }
    Flatten(allCategories.Where(c => c.ParentCategoryId == null), 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-family: 'Outfit', sans-serif; font-weight: 700; margin: 0; color: var(--admin-text);">
            <i class="bi bi-pencil-square text-warning me-2"></i> Kategori Düzenle: <span class="text-warning">@Model.Name</span>
        </h4>
        <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin: 4px 0 0;">
            Kategoriye ait genel bilgileri ve dinamik teknik alanlarını buradan yönetebilirsiniz.
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Kategoriler
    </a>
</div>

<form asp-action="Edit" method="post" id="categoryForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    
    <div class="row g-4">
        <!-- Sol Kolon (Genel Bilgiler) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4" style="background: var(--admin-surface); border: 1px solid var(--admin-border) !important;">
                <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between" style="background: #0f172a; border-radius: 16px 16px 0 0; color: #ffffff;">
                    <div class="d-flex align-items-center gap-2 font-outfit fw-bold" style="font-size: 1.05rem;">
                        <i class="bi bi-sliders text-warning"></i> Genel Bilgiler
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary mb-1">Kategori Adı</label>
                        <input asp-for="Name" class="form-control admin-form-control py-2" placeholder="Örn: Ekran Kartı" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary mb-1">Üst Kategori</label>
                        <select asp-for="ParentCategoryId" class="form-select admin-form-control py-2">
                            <option value="">-- Ana Kategori (ROOT) --</option>
                            @foreach (var item in flattenedCategories)
                            {
                                var indent = new string('-', item.Level * 2);
                                var text = (item.Level > 0 ? indent + " " : "") + item.Category.Name;
                                <option value="@item.Category.Id" selected="@(Model?.ParentCategoryId == item.Category.Id)">@text</option>
                            }
                        </select>
                        <div class="form-text text-muted small mt-1">Alt kategori eklemek için ana kategorisini seçin.</div>
                    </div>

                    <div class="mb-2">
                        <div class="form-check form-switch d-flex align-items-center gap-2 p-0">
                            <input asp-for="IsShowcase" class="form-check-input ms-0 me-2" type="checkbox" role="switch" style="width: 2.5em; height: 1.3em; cursor: pointer;">
                            <label asp-for="IsShowcase" class="form-check-label fw-bold text-dark mb-0" style="cursor: pointer;">Ana Sayfada Göster</label>
                        </div>
                        <div class="form-text text-muted small mt-2">Bu kategori ana sayfada öne çıkanlar arasında gösterilsin mi?</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon (Özellikler) -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4" style="background: var(--admin-surface); border: 1px solid var(--admin-border) !important;">
                <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between" style="background: #0f172a; border-radius: 16px 16px 0 0; color: #ffffff;">
                    <div class="d-flex align-items-center gap-2 font-outfit fw-bold" style="font-size: 1.05rem;">
                        <i class="bi bi-cpu-fill text-warning"></i> Özellikler (Attributes)
                    </div>
                    <button type="button" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark px-3 d-flex align-items-center gap-1 shadow-sm" id="addAttrBtn">
                        <i class="bi bi-plus-circle-fill"></i> Özellik Ekle
                    </button>
                </div>
                <div class="card-body p-4" id="attributesContainer">
                    <div id="emptyAttrMsg" class="text-center py-5 border rounded-4 text-muted" style="border-style: dashed !important; border-color: var(--admin-border) !important; background: var(--admin-bg); @(Model.Attributes != null && Model.Attributes.Any() ? "display:none;" : "")">
                        <i class="bi bi-tags display-5 text-warning opacity-75 d-block mb-2"></i>
                        <p class="mb-1 fw-bold text-dark">Henüz eklenmiş özellik bulunmuyor.</p>
                        <small class="text-muted">Bu kategoriye özel teknik alanlar eklemek için üstteki <b>+ Özellik Ekle</b> butonunu kullanın.</small>
                    </div>

                    @if (Model.Attributes != null && Model.Attributes.Any())
                    {
                        @for (int i = 0; i < Model.Attributes.Count; i++)
                        {
                            var attr = Model.Attributes[i];
                            <div class="card mb-3 attr-row shadow-sm border-0" data-index="@i" style="background: var(--admin-bg); border: 1px solid var(--admin-border) !important; border-radius: 12px;">
                                <div class="card-body p-3">
                                    <input type="hidden" name="Attributes.Index" value="@i" />
                                    <input type="hidden" name="Attributes[@i].Id" value="@attr.Id" />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label text-muted fw-semibold mb-1" style="font-size: 0.75rem;">Kod Adı (ID)</label>
                                            <input type="text" name="Attributes[@i].Name" value="@attr.Name" class="form-control form-control-sm font-mono border-0 bg-white text-dark" style="border: 1px solid #cbd5e1 !important; border-radius: 6px;" required @(attr.Id.HasValue ? "readonly" : "")>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted fw-semibold mb-1" style="font-size: 0.75rem;">Görünen Ad</label>
                                            <input type="text" name="Attributes[@i].DisplayName" value="@attr.DisplayName" class="form-control form-control-sm fw-semibold border-0 bg-white text-dark" style="border: 1px solid #cbd5e1 !important; border-radius: 6px;" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-muted fw-semibold mb-1" style="font-size: 0.75rem;">Veri Tipi</label>
                                            <select name="Attributes[@i].Type" class="form-select form-select-sm border-0 bg-white text-dark" style="border: 1px solid #cbd5e1 !important; border-radius: 6px;">
                                                <!option value="Text" @(attr.Type == AttributeType.Text ? "selected" : "")>Metin (String)</!option>
                                                <!option value="Number" @(attr.Type == AttributeType.Number ? "selected" : "")>Sayı (Number)</!option>
                                                <!option value="Dropdown" @(attr.Type == AttributeType.Dropdown ? "selected" : "")>Açılır Liste</!option>
                                                <!option value="Boolean" @(attr.Type == AttributeType.Boolean ? "selected" : "")>Evet/Hayır</!option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-attr-btn rounded-2 d-flex align-items-center justify-content-center gap-1" data-has-id="@(attr.Id.HasValue ? "true" : "false")">
                                                <i class="bi bi-trash-fill"></i> Sil
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Alt Butonlar -->
    <div class="card border-0 shadow-sm mt-4 p-3 rounded-4" style="background: var(--admin-surface); border: 1px solid var(--admin-border) !important;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted small d-none d-sm-block">
                <i class="bi bi-shield-check text-warning me-1"></i> Yapılan değişiklikler kaydettiğiniz anda sistemde aktifleşecektir.
            </div>
            <div class="d-flex gap-2 ms-auto">
                <a href="@Url.Action("Index")" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold">İptal</a>
                <button type="submit" class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function reindexAttributes() {
            const rows = document.querySelectorAll('.attr-row');
            rows.forEach((row, index) => {
                row.setAttribute('data-index', index);

                const indexInput = row.querySelector('input[name="Attributes.Index"]');
                if (indexInput) {
                    indexInput.value = index;
                }

                row.querySelectorAll('input, select').forEach(input => {
                    if (input.name && input.name !== 'Attributes.Index') {
                        input.name = input.name.replace(/Attributes\[\d+\]/, `Attributes[${index}]`);
                    }
                });
            });
        }

        let attrIndex = @(Model.Attributes?.Count ?? 0);

        document.getElementById('addAttrBtn').addEventListener('click', function() {
            document.getElementById('emptyAttrMsg').style.display = 'none';
            const container = document.getElementById('attributesContainer');
            const currentIndex = document.querySelectorAll('.attr-row').length;

            const html = `
                <div class="card mb-3 attr-row shadow-sm border-0" data-index="${currentIndex}" style="background: var(--admin-bg); border: 1px solid var(--admin-border) !important; border-radius: 12px;">
                    <div class="card-body p-3">
                        <input type="hidden" name="Attributes.Index" value="${currentIndex}" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-semibold mb-1" style="font-size: 0.75rem;">Kod Adı (ID)</label>
                                <input type="text" name="Attributes[${currentIndex}].Name" class="form-control form-control-sm font-mono border-0 bg-white text-dark" style="border: 1px solid #cbd5e1 !important; border-radius: 6px;" placeholder="örn: frequency" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted fw-semibold mb-1" style="font-size: 0.75rem;">Görünen Ad</label>
                                <input type="text" name="Attributes[${currentIndex}].DisplayName" class="form-control form-control-sm fw-semibold border-0 bg-white text-dark" style="border: 1px solid #cbd5e1 !important; border-radius: 6px;" placeholder="örn: Frekans" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-semibold mb-1" style="font-size: 0.75rem;">Veri Tipi</label>
                                <select name="Attributes[${currentIndex}].Type" class="form-select form-select-sm border-0 bg-white text-dark" style="border: 1px solid #cbd5e1 !important; border-radius: 6px;">
                                    <option value="Text">Metin (String)</option>
                                    <option value="Number">Sayı (Number)</option>
                                    <option value="Dropdown">Açılır Liste</option>
                                    <option value="Boolean">Evet/Hayır</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-attr-btn rounded-2 d-flex align-items-center justify-content-center gap-1" data-has-id="false">
                                    <i class="bi bi-trash-fill"></i> Sil
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            reindexAttributes();
        });

        document.getElementById('attributesContainer').addEventListener('click', function(e) {
            const btn = e.target.closest('.remove-attr-btn');
            if (btn) {
                const row = btn.closest('.attr-row');
                const hasId = btn.getAttribute('data-has-id') === 'true';
                if (hasId) {
                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: "Bu özelliği silerseniz, bu kategori ve alt kategorilerindeki TÜM ürünlerden bu özelliğe ait veriler KALICI olarak silinecektir! İşlemi geri alamazsınız.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Evet, Sil!',
                        cancelButtonText: 'İptal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            removeRow(row);
                        }
                    });
                } else {
                    removeRow(row);
                }
            }
        });

        function removeRow(row) {
            row.remove();
            reindexAttributes();
            if (document.querySelectorAll('.attr-row').length === 0) {
                document.getElementById('emptyAttrMsg').style.display = 'block';
            }
        }

        document.getElementById('categoryForm').addEventListener('submit', function() {
            reindexAttributes();
        });
    </script>
}