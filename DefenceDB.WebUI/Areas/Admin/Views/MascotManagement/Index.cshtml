@model IEnumerable<DefenceDB.EL.Models.MascotSetting>

@{
    ViewData["Title"] = "Maskot Mesaj Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Maskot Mesaj Yönetimi</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Mesaj Ekle</a>
</div>

<div class="card shadow-sm border-0 bg-theme-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-theme mb-0">
                <thead>
                    <tr>
                        <th>Hedef Sayfa</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="max-width: 300px;">
                                <div style="max-height: 100px; overflow-y: auto;">
                                    <code style="white-space: pre-wrap;">@item.TargetPath</code>
                                </div>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#linksModal_@item.Id">
                                    <i class="bi bi-box-arrow-up-right"></i> Sayfaya Git
                                </button>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</button>
                                </form>
                            </td>
                        </tr>
                        
                        <!-- Links Modal -->
                        <div class="modal fade text-start" id="linksModal_@item.Id" tabindex="-1" aria-hidden="true">
                          <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content">
                              <div class="modal-header">
                                <h5 class="modal-title">Maskotun Çıkacağı Sayfalar</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body">
                                <div class="list-group list-group-flush">
                                    @{
                                        var links = item.TargetPath.Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).ToList();
                                        if (links.Any())
                                        {
                                            foreach (var link in links)
                                            {
                                                <a href="@link" target="_blank" class="list-group-item list-group-item-action text-primary text-break">
                                                    <i class="bi bi-link-45deg me-2"></i>@link
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted">Link bulunamadı.</div>
                                        }
                                    }
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Henüz maskot mesajı eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
