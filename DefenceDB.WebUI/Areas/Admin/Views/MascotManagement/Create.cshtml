@model DefenceDB.EL.Models.MascotSetting
@using DefenceDB.EL.Models

@{
    ViewData["Title"] = "Yeni Maskot Mesajı";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Geri Dön</a>
</div>

<div class="card shadow-sm border-0 bg-theme-card">
    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
        <h4 class="mb-0">Yeni Maskot Mesajı Ekle</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TargetPath" class="form-label fw-bold"></label>
                <textarea asp-for="TargetPath" class="form-control" rows="3" placeholder="/Product?categorySlug=balistik-fuzeler&#10;/Product?categorySlug=baska-kategori"></textarea>
                <span asp-validation-for="TargetPath" class="text-danger"></span>
                <div class="form-text">Mesajın görüneceği sayfanın URL yolu. Birden fazla eklemek için alt satıra geçebilirsiniz (veya virgül). Tüm sayfalarda görünmesi için <code>*</code> yazın.</div>
                
                @{
                    var categories = ViewBag.Categories as List<Category>;
                }
                @if(categories != null && categories.Any())
                {
                    <div class="mt-3 border rounded p-3 bg-light">
                        <p class="mb-2 fw-bold text-secondary small"><i class="bi bi-funnel"></i> Hızlı Kategori Seçimi (İşaretledikleriniz yukarıdaki listeye otomatik eklenir)</p>
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var cat in categories.OrderBy(c => c.Name))
                            {
                                var urlVal = $"/Product?categorySlug={cat.Slug}";
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input category-checkbox" type="checkbox" value="@urlVal" id="cat_@cat.Id" onchange="toggleCategoryUrl(this)">
                                        <label class="form-check-label text-truncate" style="font-size: 0.9rem; max-width: 90%;" for="cat_@cat.Id" title="@cat.Name">
                                            @cat.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Message" class="form-label fw-bold">Mesaj İçeriği (Markdown)</label>
                <textarea asp-for="Message" class="form-control" rows="5" placeholder="**Kalın**, *eğik* yazabilir, maddeler ekleyebilirsiniz."></textarea>
                <div class="form-text">Markdown formatını kullanarak metni biçimlendirebilirsiniz.</div>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label fw-bold"></label>
            </div>

            <hr />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Kaydet</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function toggleCategoryUrl(checkbox) {
            var textarea = document.getElementById('TargetPath');
            var url = checkbox.value;
            var val = textarea.value.trim();
            
            var lines = val ? val.split(/\r?\n|,/).map(l => l.trim()).filter(l => l !== '') : [];
            
            if (checkbox.checked) {
                if (!lines.includes(url)) {
                    lines.push(url);
                }
            } else {
                lines = lines.filter(l => l !== url);
            }
            
            textarea.value = lines.join('\n');
        }

        document.addEventListener("DOMContentLoaded", function() {
            var textarea = document.getElementById('TargetPath');
            var checkboxes = document.querySelectorAll('.category-checkbox');
            
            function syncCheckboxes() {
                var val = textarea.value.trim();
                var lines = val ? val.split(/\r?\n|,/).map(l => l.trim()).filter(l => l !== '') : [];
                checkboxes.forEach(function(cb) {
                    cb.checked = lines.includes(cb.value);
                });
            }
            
            // Initial sync
            syncCheckboxes();
            
            // Sync on typing
            textarea.addEventListener('input', syncCheckboxes);
        });
    </script>
}
